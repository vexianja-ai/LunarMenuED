	local counts = {}
	if folder then
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") then
				counts[d.Name] = (counts[d.Name] or 0) + 1
			end
		end
	else
		for _, d in ipairs(Workspace:GetChildren()) do
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(d) then
				counts[d.Name] = (counts[d.Name] or 0) + 1
			end
		end
	end
	local list = {}
	for name, c in pairs(counts) do table.insert(list, { name = name, count = c }) end
	table.sort(list, function(a, b) return a.name < b.name end)
	return list
end

local function forEachAnimal(fn)
	local folder = getAnimalFolder()
