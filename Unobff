	local function addTooltip(obj, text)
		local function show()
			tooltip.Text = text
			tooltip.Size = UDim2.fromOffset(tooltip.TextBounds.X + 20, 22)
			local mp = UserInputService:GetMouseLocation()
			local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
			tooltip.Position = UDim2.fromOffset(
				math.clamp(mp.X + 14, 4, math.max(vp.X - tooltip.Size.X.Offset - 4, 4)),
				math.clamp(mp.Y + 18, 4, math.max(vp.Y - 26, 4)))
			tooltip.Visible = true
			TweenService:Create(tooltip, TweenInfo.new(0.15), { TextTransparency = 0, BackgroundTransparency = 0.05 }):Play()
		end
		local function hide()
			local t = TweenService:Create(tooltip, TweenInfo.new(0.12), { TextTransparency = 1 })
			t:Play(); t.Completed:Connect(function() tooltip.Visible = false end)
		end
		obj.MouseEnter:Connect(show); obj.MouseLeave:Connect(hide)
		obj.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then show() end end)
		obj.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then hide() end end)
