local function ripple(btn)
	local mp = UserInputService:GetMouseLocation()
	local px = mp.X - btn.AbsolutePosition.X
	local py = mp.Y - btn.AbsolutePosition.Y
	local size = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 1.6
	local r = make("Frame", {
		Size = UDim2.new(0, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, px, 0, py),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.75, BorderSizePixel = 0, ZIndex = 2,
	}, btn)
	corner(r, 999)
	TweenService:Create(r, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, size, 0, size), BackgroundTransparency = 1
	}):Play()
	Debris:AddItem(r, 0.5)
end
local function previewModel(parent, model, size)
	local vp = make("ViewportFrame", { Size = size, BackgroundColor3 = T.PanelD, BackgroundTransparency = 0.4 }, parent)
	corner(vp, 6)
	local cam = newViewportCamera(vp)
	vp.CurrentCamera = cam
	local world = make("WorldModel", {}, vp)
	if not model then
		cam.CFrame = CFrame.new(Vector3.new(3, 3, 3), Vector3.zero)
		return vp
	end
	local clone = model:Clone()
	clone.Parent = world
	if clone:IsA("Model") then
		clone:PivotTo(CFrame.new())
		local ok, bounds = pcall(function() local _, b = clone:GetBoundingBox(); return b end)
		local dist = (ok and bounds and bounds.Magnitude or 4) * 0.9 + 1.5
		cam.CFrame = CFrame.new(Vector3.new(1, 0.65, 1).Unit * dist, Vector3.zero)
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new()
		cam.CFrame = CFrame.new(Vector3.new(1, 0.65, 1).Unit * (clone.Size.Magnitude * 0.9 + 1.5), Vector3.zero)
	end
	return vp
end

