local SAVE_FOLDER = "LunarMenu"
local SAVE_FILE = SAVE_FOLDER .. "/config.json"
local FALLBACK_FILE = "LunarMenu_config.json"
local HAS_FS = (type(writefile) == "function" and type(readfile) == "function")
local saveQueued = false
local saveDirty = false
local onDirtyChanged = function() end

local function setDirty(v)
	if saveDirty == v then return end
	saveDirty = v
	pcall(onDirtyChanged)
end

-- only create the folder if it genuinely doesn't exist yet
local function ensureSaveFolder()
	if type(isfolder) ~= "function" or type(makefolder) ~= "function" then return false end
	local ok, exists = pcall(isfolder, SAVE_FOLDER)
	if ok and exists then return true end
	local made = pcall(makefolder, SAVE_FOLDER)
	return made and true or false
end

local function fileExists(path)
	if type(isfile) ~= "function" then return false end
	local ok, res = pcall(isfile, path)
	return ok and res == true
end

local function resolveSavePath()
	if ensureSaveFolder() then return SAVE_FILE end
	return FALLBACK_FILE
end

local function buildConfigTable()
	local kb = {}
	for act, key in pairs(keybinds) do kb[act] = key.Name end
	local th = {}
	for k, c in pairs(T) do th[k] = { c.R, c.G, c.B } end
	local ignored = {}
	for n, v in pairs(animalIgnore) do if v then table.insert(ignored, n) end end

	return {
		keybinds = kb,
		theme = th,
		settings = {
			RelaunchOnRejoin = settingsCfg.RelaunchOnRejoin,
			AutoSave = settingsCfg.AutoSave,
			LastPlaceId = settingsCfg.LastPlaceId,
			LastJobId = settingsCfg.LastJobId,
		},
		state = {
			throwable = currentThrowableName,
			walkSpeed = walkSpeedValue,
			espDist = MAX_ESP_DISTANCE,
			animalDist = ANIMAL_ESP_DISTANCE,
			espTeamColors = espTeamColors,
			espShowHealth = espShowHealth,
			espFriendsOnly = espFriendsOnly,
			animalEspHealth = animalEspHealth,
			animalIgnore = ignored,
			build = {
				AxisOffset = { X = buildState.AxisOffset.X, Y = buildState.AxisOffset.Y, Z = buildState.AxisOffset.Z },
				Rotation = { X = buildState.Rotation.X, Y = buildState.Rotation.Y, Z = buildState.Rotation.Z },
				StructureName = buildState.StructureName,
			},
			spread = { Range = spreadCfg.Range, CustomItem = spreadCfg.CustomItem,
				TargetPlayers = spreadCfg.TargetPlayers, Duration = spreadCfg.Duration },
			protect = { Radius = protectExtras.Radius, Interval = protectExtras.Interval,
				CustomItem = protectExtras.CustomItem, Count = protectExtras.Count, Delay = protectExtras.Delay },
			line = { Range = lineCfg.Range, PerStuds = lineCfg.PerStuds,
				GroundSnap = lineCfg.GroundSnap, CustomStructure = lineCfg.CustomStructure },
			trap = { Amount = trapCfg.Amount, CustomStructure = trapCfg.CustomStructure,
				Target = type(trapCfg.Target) == "string" and trapCfg.Target or "all" },
			concurrent = { Spacing = concurrent.Spacing, MaxRange = concurrent.MaxRange,
				PerStuds = concurrent.PerStuds, GroundSnap = concurrent.GroundSnap },
			throwCount = throwCount, throwDelay = throwDelay, throwShape = throwShape,
			flags = {
				esp = playerEspActive, fullbright = fullBrightActive, firstPerson = firstPersonActive,
				infZoom = infZoomActive, walkBoost = walkBoostActive, animalEsp = animalEspActive,
				protect = protectModeActive, throw = throwEnabled,
			},
		},
	}
end

local function writeConfigToDisk()
	if not HAS_FS then return false end
	local ok, encoded = pcall(function() return HttpService:JSONEncode(buildConfigTable()) end)
	if not ok or not encoded then return false end

	local target = resolveSavePath()
	local wrote = pcall(function()
		if fileExists(target) then
			writefile(target, encoded)
		else
			writefile(target, encoded)
		end
	end)

	if not wrote then
		wrote = pcall(function() writefile(FALLBACK_FILE, encoded) end)
	end
	return wrote and true or false
end

-- saveConfig(force): force = true ignores the Auto Save setting (used by the Save button)
local function saveConfig(force)
	if not HAS_FS then return end
	setDirty(true)
	if not force and not settingsCfg.AutoSave then return end
	if saveQueued then return end
	saveQueued = true
	task.delay(0.6, function()
		saveQueued = false
		local ok = writeConfigToDisk()
		if ok then setDirty(false) end
	end)
end

local function readConfigFile()
	if not HAS_FS then return nil end
	for _, path in ipairs({ SAVE_FILE, FALLBACK_FILE }) do
		if fileExists(path) then
			local ok, raw = pcall(readfile, path)
			if ok and raw and raw ~= "" then
				local decoded, data = pcall(function() return HttpService:JSONDecode(raw) end)
				if decoded and type(data) == "table" then return data end
			end
		end
	end
	return nil
end

local function loadConfig()
	local data = readConfigFile()
	if type(data) ~= "table" then return end

	if type(data.keybinds) == "table" then
		for act, name in pairs(data.keybinds) do
			local kc = Enum.KeyCode[name]
			if kc then keybinds[act] = kc end
		end
	end

	if type(data.theme) == "table" then
		for k, rgb in pairs(data.theme) do
			if T[k] and type(rgb) == "table" and #rgb >= 3 then
				T[k] = Color3.new(rgb[1], rgb[2], rgb[3])
			end
		end
	end

	local s = data.settings
	if type(s) == "table" then
		settingsCfg.RelaunchOnRejoin = s.RelaunchOnRejoin == true
		if s.AutoSave ~= nil then settingsCfg.AutoSave = s.AutoSave ~= false end
		settingsCfg.LastPlaceId = tonumber(s.LastPlaceId) or 0
		settingsCfg.LastJobId = tostring(s.LastJobId or "")
	end

	local st = data.state
	if type(st) == "table" then
		currentThrowableName = st.throwable or currentThrowableName
		walkSpeedValue = tonumber(st.walkSpeed) or walkSpeedValue
		MAX_ESP_DISTANCE = tonumber(st.espDist) or MAX_ESP_DISTANCE
		ANIMAL_ESP_DISTANCE = tonumber(st.animalDist) or ANIMAL_ESP_DISTANCE
		espTeamColors = st.espTeamColors == true
		espShowHealth = st.espShowHealth == true
		espFriendsOnly = st.espFriendsOnly == true
		animalEspHealth = st.animalEspHealth == true
		if type(st.animalIgnore) == "table" then
			for _, n in ipairs(st.animalIgnore) do animalIgnore[n] = true end
		end

		-- builder offsets: restore every axis that was modified
		local bd = st.build
		if type(bd) == "table" then
			local ao = bd.AxisOffset
			if type(ao) == "table" then
				buildState.AxisOffset.X = tonumber(ao.X) or 0
				buildState.AxisOffset.Y = tonumber(ao.Y) or 0
				buildState.AxisOffset.Z = tonumber(ao.Z) or 0
			end
			local rt = bd.Rotation
			if type(rt) == "table" then
				buildState.Rotation = Vector3.new(
					tonumber(rt.X) or 0, tonumber(rt.Y) or 0, tonumber(rt.Z) or 0)
			end
			if type(bd.StructureName) == "string" and bd.StructureName ~= "" then
				buildState.StructureName = bd.StructureName
			end
		end

		local sp = st.spread
		if type(sp) == "table" then
			spreadCfg.Range = tonumber(sp.Range) or spreadCfg.Range
			spreadCfg.CustomItem = sp.CustomItem or spreadCfg.CustomItem
			spreadCfg.TargetPlayers = sp.TargetPlayers == true
			spreadCfg.Duration = tonumber(sp.Duration) or spreadCfg.Duration
		end
		local pr = st.protect
		if type(pr) == "table" then
			protectExtras.Radius = tonumber(pr.Radius) or protectExtras.Radius
			protectExtras.Interval = tonumber(pr.Interval) or protectExtras.Interval
			protectExtras.CustomItem = pr.CustomItem or protectExtras.CustomItem
			protectExtras.Count = tonumber(pr.Count) or protectExtras.Count
			protectExtras.Delay = tonumber(pr.Delay) or protectExtras.Delay
		end
		local ln = st.line
		if type(ln) == "table" then
			lineCfg.Range = tonumber(ln.Range) or lineCfg.Range
			lineCfg.PerStuds = tonumber(ln.PerStuds) or lineCfg.PerStuds
			lineCfg.GroundSnap = ln.GroundSnap ~= false
			lineCfg.CustomStructure = ln.CustomStructure or lineCfg.CustomStructure
		end
		local tr = st.trap
		if type(tr) == "table" then
			trapCfg.Amount = tonumber(tr.Amount) or trapCfg.Amount
			trapCfg.CustomStructure = tr.CustomStructure or trapCfg.CustomStructure
			trapCfg.Target = tr.Target or trapCfg.Target
		end
		local cc = st.concurrent
		if type(cc) == "table" then
			concurrent.Spacing = tonumber(cc.Spacing) or concurrent.Spacing
			concurrent.MaxRange = tonumber(cc.MaxRange) or concurrent.MaxRange
			concurrent.PerStuds = tonumber(cc.PerStuds) or concurrent.PerStuds
			concurrent.GroundSnap = cc.GroundSnap ~= false
		end
		throwCount = tonumber(st.throwCount) or throwCount
		throwDelay = tonumber(st.throwDelay) or throwDelay
		throwShape = st.throwShape or throwShape
		local fl = st.flags
		if type(fl) == "table" then
			playerEspActive = fl.esp == true
			fullBrightActive = fl.fullbright == true
			firstPersonActive = fl.firstPerson == true
			infZoomActive = fl.infZoom == true
			walkBoostActive = fl.walkBoost == true
			animalEspActive = fl.animalEsp == true
			protectModeActive = fl.protect == true
			throwEnabled = fl.throw == true
		end
	end
end

