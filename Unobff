		------------------------------------------------
		-- HELPERS
		------------------------------------------------
		local function snapScalar(v, inc)
			if not inc or inc <= 0 then return v end
			return math.round(v / inc) * inc
		end
		local function snapVec(v, inc)
			if not inc or inc <= 0 then return v end
			return Vector3.new(snapScalar(v.X, inc), snapScalar(v.Y, inc), snapScalar(v.Z, inc))
		end
		local function rotOnly(cf) return cf - cf.Position end

		local function viewportRay(x, y)
			return Workspace.CurrentCamera:ViewportPointToRay(x, y)
		end
		local function rayPlane(ray, planeCF)
			local n = planeCF.LookVector
			local denom = ray.Direction:Dot(n)
			if math.abs(denom) < 1e-5 then return nil end
			local t = (planeCF.Position - ray.Origin):Dot(n) / denom
			if t < 0 then return nil end
			return ray.Origin + ray.Direction * t
		end

		local function surfaceRay()
			local ray = viewportRay(pointer.X, pointer.Y)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			local ignore = { sandbox, handleFolder }
			if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
			rp.FilterDescendantsInstances = ignore
			rp.IgnoreWater = true
			return Workspace:Raycast(ray.Origin, ray.Direction * 2000, rp)
		end

		local function structRay()
			local ray = viewportRay(pointer.X, pointer.Y)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Include
			rp.FilterDescendantsInstances = { sandbox }
			local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, rp)
			if not res then return nil end
			local model = res.Instance:FindFirstAncestorOfClass("Model")
			while model and model.Parent ~= sandbox do model = model.Parent end
			if model and model.Parent == sandbox then return model, res.Position end
			return nil
		end

		local function isChild(model) return model and model.Parent == sandbox end
		local function primary() return selected[1] end
		local function allModels()
			local out = {}
			for _, m in ipairs(sandbox:GetChildren()) do
				if m:IsA("Model") then table.insert(out, m) end
			end
			return out
		end

		------------------------------------------------
		-- SELECTION
		------------------------------------------------
		local function clearBoxes()
			for _, b in pairs(boxes) do if b then b:Destroy() end end
			boxes = {}
		end

		local function markSelected(model)
			if boxes[model] then return end
			boxes[model] = make("SelectionBox", { Adornee = model, LineThickness = 0.035,
				Color3 = T.Accent, Transparency = 0.2, SurfaceTransparency = 1 }, model)
		end

		local function setSelection(list)
			clearBoxes()
			selected = {}
			for _, m in ipairs(list) do
				if isChild(m) then
					table.insert(selected, m)
					markSelected(m)
				end
			end
			refreshHandles()
		end

		local function toggleSelection(model)
			local i = table.find(selected, model)
			if i then
				table.remove(selected, i)
				if boxes[model] then boxes[model]:Destroy(); boxes[model] = nil end
			else
				table.insert(selected, model)
				markSelected(model)
			end
			refreshHandles()
		end

		local function clearSelection()
			clearBoxes()
			selected = {}
			clearHandles()
		end

		------------------------------------------------
		-- NATIVE GIZMOS
		------------------------------------------------
		local gizmo = nil

		function clearHandles()
			if gizmo then gizmo:Destroy(); gizmo = nil end
			if anchor then anchor:Destroy(); anchor = nil end
			for _, a in ipairs(lineAdorn) do if a then a:Destroy() end end
			lineAdorn = {}
			for _, c in ipairs(handleFolder:GetChildren()) do c:Destroy() end
		end

		local function finishDrag()
			if not dragging then return end
			pushHistory()
			dragging = nil
			clearLine()
			refreshHandles()
		end

		function refreshHandles()
			clearHandles()
			local m = primary()
			if not m or not tool then return end
			if tool ~= "Move" and tool ~= "Rotate" then return end

			anchor = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
				CastShadow = false, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2),
				CFrame = m:GetPivot() }, handleFolder)

			if tool == "Move" then
				local h = Instance.new("Handles")
				pcall(function() h.Style = Enum.HandlesStyle.MoveRotate end)
				h.Faces = { Enum.NormalId.Right, Enum.NormalId.Top, Enum.NormalId.Back,
					Enum.NormalId.Left, Enum.NormalId.Bottom, Enum.NormalId.Front }
				h.Adornee = anchor
				h.Parent = anchor
				gizmo = h

				local base = m:GetPivot()
				h.MouseButton1Down:Connect(function()
					base = m:GetPivot()
					dragging = { mode = "native", model = m, base = base }
				end)
				h.MouseDrag:Connect(function(face, distance)
					if not dragging or dragging.mode ~= "native" then return end
					local normal = Vector3.FromNormalId(face)
					local np = snapVec(dragging.base.Position + normal * distance, buildState.MoveIncrement)
					local cf = CFrame.new(np) * rotOnly(dragging.base)
					dragging.model:PivotTo(cf)
					if anchor then anchor.CFrame = cf end
					updateLine(cf.Position, cf.Position + normal * 4)
				end)
				h.MouseButton1Up:Connect(finishDrag)
			else
				local a = Instance.new("ArcHandles")
				a.Axes = { Enum.Axis.Y }
				a.Adornee = anchor
				a.Parent = anchor
				gizmo = a

				local base = m:GetPivot()
				a.MouseButton1Down:Connect(function()
					base = m:GetPivot()
					dragging = { mode = "native", model = m, base = base }
				end)
				a.MouseDrag:Connect(function(_axis, angle)
					if not dragging or dragging.mode ~= "native" then return end
					local cf = dragging.base * CFrame.Angles(0, angle, 0)
					dragging.model:PivotTo(cf)
					if anchor then anchor.CFrame = cf end
					local plane = CFrame.lookAt(cf.Position, cf.Position + Workspace.CurrentCamera.CFrame.LookVector)
					local hit = rayPlane(viewportRay(pointer.X, pointer.Y), plane)
					if hit then updateLine(cf.Position, hit) end
				end)
				a.MouseButton1Up:Connect(finishDrag)
			end
		end

		------------------------------------------------
		-- DOTTED LINE
		------------------------------------------------
		local function clearLine()
			for _, a in ipairs(lineAdorn) do if a then a:Destroy() end end
			lineAdorn = {}
		end

		function updateLine(a, b)
			local dir = b - a
			local dist = dir.Magnitude
			if dist < 0.4 then clearLine(); return end
			local count = math.clamp(math.floor(dist / 0.6), 4, 40)
			while #lineAdorn < count do
				table.insert(lineAdorn, make("SphereHandleAdornment", {
					Adornee = Workspace.Terrain, Radius = 0.11, Color3 = Color3.fromRGB(120, 220, 255),
					AlwaysOnTop = true, CFrame = CFrame.new() }, handleFolder))
			end
			for i = 1, count do
				lineAdorn[i].CFrame = CFrame.new(a + dir * (i / (count + 1)))
			end
			for i = count + 1, #lineAdorn do
				lineAdorn[i].CFrame = CFrame.new(0, -6000, 0)
			end
		end

		------------------------------------------------
		-- HISTORY
		------------------------------------------------
		local function snapshot()
			local snap = {}
			for _, m in ipairs(allModels()) do
				table.insert(snap, { id = m:GetAttribute("StructureName"), cf = m:GetPivot() })
			end
			return snap
		end

		local function respawn(id, cf)
			local src = getStructureByName(id)
			if not src then return nil end
			local clone = src:Clone()
			clone:SetAttribute("StructureName", id)
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.Transparency = 0.4
				end
			end
			clone.Parent = sandbox
			clone:PivotTo(cf)
			return clone
		end

		local function restore(snap)
			clearSelection()
			for _, m in ipairs(allModels()) do m:Destroy() end
			for _, e in ipairs(snap) do
				if e.id then respawn(e.id, e.cf) end
			end
		end

		function pushHistory()
			if historyBusy then return end
			table.insert(undoStack, snapshot())
			if #undoStack > 60 then table.remove(undoStack, 1) end
			redoStack = {}
		end

		local function doUndo()
			if #undoStack == 0 then showNotification("Nothing to undo", 1.2); return end
			local current = snapshot()
			local prev = table.remove(undoStack)
			table.insert(redoStack, current)
			historyBusy = true; restore(prev); historyBusy = false
		end

		local function doRedo()
			if #redoStack == 0 then showNotification("Nothing to redo", 1.2); return end
			local current = snapshot()
			local nxt = table.remove(redoStack)
			table.insert(undoStack, current)
			historyBusy = true; restore(nxt); historyBusy = false
		end

