		------------------------------------------------
		local function deleteSelected()
			if #selected == 0 then return end
			pushHistory()
			for _, m in ipairs(selected) do m:Destroy() end
			clearSelection()
		end

		local function cloneSelected()
			if #selected == 0 then return end
			pushHistory()
			local made = {}
			for _, m in ipairs(selected) do
				local c = m:Clone()
				c.Parent = sandbox
				c:PivotTo(m:GetPivot() + Vector3.new(math.max(buildState.MoveIncrement, 1) * 2, 0, 0))
				table.insert(made, c)
			end
			setSelection(made)
		end

		local function spawnInFront(name)
			local src = getStructureByName(name)
			if not src then showNotification("Structure not found: " .. name, 2); return nil end
			local cam = Workspace.CurrentCamera
			local ray = viewportRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			local ignore = { sandbox, handleFolder }
			if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
			rp.FilterDescendantsInstances = ignore
			local hit = Workspace:Raycast(ray.Origin, ray.Direction * 60, rp)
			local pos = hit and hit.Position or (cam.CFrame.Position + cam.CFrame.LookVector * 14)
			pos = snapVec(pos, buildState.MoveIncrement)
			local m = respawn(name, CFrame.new(pos))
			if m then setSelection({ m }) end
			return m
		end

