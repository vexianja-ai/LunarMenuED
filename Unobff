local function resolveTargets(list)
	local out, seen = {}, {}
	local function add(pl)
		if pl and pl.Parent and not seen[pl] then seen[pl] = true; table.insert(out, pl) end
	end
	for _, v in ipairs(list or {}) do
		if v == "All" then
			for _, pl in ipairs(Players:GetPlayers()) do add(pl) end
		elseif v == "Others" then
			for _, pl in ipairs(Players:GetPlayers()) do if pl ~= LocalPlayer then add(pl) end end
		elseif v == "Nearest" then
			local best, bd
			local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if root then
				for _, pl in ipairs(Players:GetPlayers()) do
					if pl ~= LocalPlayer and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
						local d = (pl.Character.HumanoidRootPart.Position - root.Position).Magnitude
						if not bd or d < bd then best, bd = pl, d end
					end
				end
			end
			add(best)
		elseif typeof(v) == "Instance" then
			add(v)
		end
	end
	return out
end

