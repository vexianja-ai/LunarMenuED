			freecam.active = true
			freecam.savedCF = cam.CFrame
			freecam.savedFOV = cam.FieldOfView
			freecam.savedType = cam.CameraType
			freecam.pos = cam.CFrame.Position
			local look = cam.CFrame.LookVector
			freecam.yaw = math.atan2(-look.X, -look.Z)
			freecam.pitch = math.asin(math.clamp(look.Y, -1, 1))
			cam.CameraType = Enum.CameraType.Scriptable
			local hum = freecamHumanoid(); if hum then hum.WalkSpeed = 0 end
			if UserInputService.MouseEnabled then UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter end
			zoomIn.Visible = true; zoomOut.Visible = true
			showNotification(IS_MOBILE and "Freecam — thumbstick move, drag to look" or
				"Freecam — WASD move, Q/E zoom, Esc exit", 2)
		end

		freecamStop = function()
			if not freecam.active then return end
			freecam.active = false
			freecam.lookTouch = nil
			freecam.zoomInHeld = false
			freecam.zoomOutHeld = false
			local cam = Workspace.CurrentCamera
			cam.CameraType = freecam.savedType or Enum.CameraType.Custom
			cam.FieldOfView = freecam.savedFOV or 70
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			freecam.held = {}
			local hum = freecamHumanoid(); if hum then hum.WalkSpeed = 12 end
			zoomIn.Visible = false; zoomOut.Visible = false
		end
		uiRefs.freecamActive = function() return freecam.active end

		RunService.RenderStepped:Connect(function(dt)
			if not freecam.active then return end
			local move = Vector3.zero
			if freecam.held[Enum.KeyCode.W] then move += Vector3.zAxis end
			if freecam.held[Enum.KeyCode.S] then move -= Vector3.zAxis end
			if freecam.held[Enum.KeyCode.A] then move -= Vector3.xAxis end
			if freecam.held[Enum.KeyCode.D] then move += Vector3.xAxis end
			if freecam.held[Enum.KeyCode.E] then move += Vector3.yAxis end
			if freecam.held[Enum.KeyCode.Q] then move -= Vector3.yAxis end

			if IS_MOBILE then
				local stick = readThumbstick()
				if stick.Magnitude > 0.02 then
					move += Vector3.new(stick.X, 0, stick.Y)
				end
			elseif freecam.controls then
				local v = freecam.controls:GetMoveVector()
				if v.Magnitude > 0.05 then
					move += Vector3.new(v.X, 0, -v.Y)
				end
			end

			local rot = CFrame.Angles(0, freecam.yaw, 0) * CFrame.Angles(freecam.pitch, 0, 0)
			if move.Magnitude > 0.01 then
				freecam.pos += rot:VectorToWorldSpace(move.Unit * (42 * dt)) * math.min(1, move.Magnitude)
			end
			Workspace.CurrentCamera.CFrame = CFrame.new(freecam.pos) * rot
			if freecam.held[Enum.KeyCode.Q] then freecam.zoom = math.min(freecam.zoom + dt, 1) end
			if freecam.held[Enum.KeyCode.E] then freecam.zoom = math.max(freecam.zoom - dt, -1) end
			if freecam.zoomInHeld then freecam.zoom = math.min(freecam.zoom + dt * 1.4, 1) end
			if freecam.zoomOutHeld then freecam.zoom = math.max(freecam.zoom - dt * 1.4, -1) end
			Workspace.CurrentCamera.FieldOfView = math.clamp(70 - freecam.zoom * 45, 18, 90)
		end)

		------------------------------------------------
		-- CURSOR DRAG (model body only)
		------------------------------------------------
		local function beginModelDrag(model, hitPos)
			local pivot = model:GetPivot()
			if tool == "Rotate" then
				dragging = { mode = "rotate", model = model, pivot = pivot, startX = pointer.X }
			else
				dragging = { mode = "free", model = model, pivot = pivot, offset = pivot.Position - hitPos }
			end
		end

		RunService.RenderStepped:Connect(function()
			if pendingDrag then
				if not pendingDrag.model or not pendingDrag.model.Parent then
					pendingDrag = nil
				elseif os.clock() - pendingDrag.at >= 0.12
					or (pointer - pendingDrag.from).Magnitude > 6 then
					beginModelDrag(pendingDrag.model, pendingDrag.hitPos)
					pendingDrag = nil
				end
			end

			if not dragging then return end
			if dragging.mode == "native" then return end
			local model = dragging.model
			if not model or not model.Parent then dragging = nil; clearLine(); return end
			local rot = rotOnly(dragging.pivot)

			if dragging.mode == "free" then
				local hit = surfaceRay()
				if hit then
					local np = hit.Position + dragging.offset
					if buildState.DragToCursor then
						np = Vector3.new(snapScalar(np.X, buildState.MoveIncrement), np.Y,
							snapScalar(np.Z, buildState.MoveIncrement))
					else
						np = snapVec(np, buildState.MoveIncrement)
					end
					local cf = CFrame.new(np) * rot
					model:PivotTo(cf)
					if anchor then anchor.CFrame = cf end
					updateLine(cf.Position, hit.Position)
				end
			elseif dragging.mode == "rotate" then
				local dx = pointer.X - dragging.startX
				local raw = math.rad(dx * buildState.RotateIncrement / 10)
				local angle = raw
				if buildState.RotateIncrement > 0 then
					local step = math.rad(buildState.RotateIncrement)
					angle = math.round(raw / step) * step
				end
				local cf = dragging.pivot * CFrame.Angles(0, angle, 0)
				model:PivotTo(cf)
				if anchor then anchor.CFrame = cf end
				local plane = CFrame.lookAt(cf.Position, cf.Position + Workspace.CurrentCamera.CFrame.LookVector)
				local hit = rayPlane(viewportRay(pointer.X, pointer.Y), plane)
				if hit then updateLine(cf.Position, hit) end
			end
		end)

		------------------------------------------------
		-- INPUT
		------------------------------------------------
		local function pressStart()
			if not buildState.IsConstructing then return end
			local model, hitPos = structRay()

			if not tool then
				if not model then return end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
					toggleSelection(model)
				else
					setSelection({ model })
				end
				return
			end

			if not model or not table.find(selected, model) then return end

			if tool == "Delete" then deleteSelected()
			elseif tool == "Copy" then cloneSelected()
			elseif tool == "Move" or tool == "Rotate" then
				pendingDrag = { model = model, hitPos = hitPos, at = os.clock(), from = pointer }
			end
		end

		local function pressEnd()
			pendingDrag = nil
			if not dragging or dragging.mode == "native" then return end
			pushHistory()
			dragging = nil
			clearLine()
			refreshHandles()
		end

		UserInputService.InputBegan:Connect(function(i, gp)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				pointer = Vector2.new(i.Position.X, i.Position.Y)
			end
			if freecam.active then
				if i.UserInputType == Enum.UserInputType.Touch and not freecam.lookTouch then
					local vp = Workspace.CurrentCamera.ViewportSize
					if i.Position.X > vp.X * 0.35 then freecam.lookTouch = i end
				end
				return
			end
			if not buildState.IsConstructing then return end
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				pressStart()
			end
		end)

		UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement then
				pointer = Vector2.new(i.Position.X, i.Position.Y)
				if freecam.active then
					freecam.yaw -= i.Delta.X * 0.22
					freecam.pitch = math.clamp(freecam.pitch - i.Delta.Y * 0.22, math.rad(-89), math.rad(89))
				end
			elseif i.UserInputType == Enum.UserInputType.Touch then
				if freecam.active then
					if i == freecam.lookTouch then
						local sens = buildState.CameraSensitivity or 0.12
						freecam.yaw -= i.Delta.X * sens
						freecam.pitch = math.clamp(freecam.pitch - i.Delta.Y * sens, math.rad(-89), math.rad(89))
					end
				else
					pointer = Vector2.new(i.Position.X, i.Position.Y)
				end
			end
		end)

		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				if i == freecam.lookTouch then freecam.lookTouch = nil end
				pressEnd()
			end
		end)

		UserInputService.InputBegan:Connect(function(i, gp)
			if gp then return end
			if freecam.active then
				if i.KeyCode == Enum.KeyCode.Escape then freecamStop() end
				freecam.held[i.KeyCode] = true
				return
			end
			if not buildState.IsConstructing then return end
			if UserInputService:GetFocusedTextBox() then return end
			local digitKeys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four,
				Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven }
			local idx = table.find(digitKeys, i.KeyCode)
			if idx and TOOLS[idx] then selectTool(TOOLS[idx].id) end
		end)

		UserInputService.InputEnded:Connect(function(i)
			freecam.held[i.KeyCode] = false
		end)

