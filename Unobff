local god = {
	Enabled = false,
	Range = 8,
	ShowHitbox = false,
	ShowNotif = true,
	ItemReplacement = "",
	Detected = false,
	HooksInstalled = false,
	Hitbox = nil,
	MobileBtn = nil,
	MobileConn = nil,
}

local function godItemName()
	if god.ItemReplacement and god.ItemReplacement ~= "" then return god.ItemReplacement end
	return currentThrowableName
end

-- true while simulating and a GOD WEAPON is present
local function godActive()
	return god.Enabled and god.Detected
end

-- true when the call originates from our own executor context
local function godIsOurCall()
	if type(checkcaller) == "function" then
		local ok, res = pcall(checkcaller)
		return ok and res == true
	end
	return false
end

-- decide for a single incoming AttemptToolUse call: block foreign, let ours through untouched
local function godShouldBlock()
	return godActive() and not godIsOurCall()
end

local function godTargetInRange()
	local ch = LocalPlayer.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LocalPlayer and pl.Character then
			local tr = pl.Character:FindFirstChild("HumanoidRootPart")
			local hum = pl.Character:FindFirstChildOfClass("Humanoid")
			if tr and hum and hum.Health > 0 and (tr.Position - hrp.Position).Magnitude <= god.Range then
				return true
			end
		end
	end
	return false
end

-- our own fire, with our own argument, only when something is in the hitbox
local function godFire()
	if not godActive() then return end
	if UserInputService:GetFocusedTextBox() then return end
	if not godTargetInRange() then return end
	if AttemptToolUse then AttemptToolUse:FireServer(godItemName()) end
end

local function godMouseOverMenu()
	local f = uiRefs.mainFrame
	if not f or not f.Parent or uiRefs.minimized then return false end
	local mp = UserInputService:GetMouseLocation()
	local ap, as = f.AbsolutePosition, f.AbsoluteSize
	return mp.X >= ap.X and mp.X <= ap.X + as.X and mp.Y >= ap.Y and mp.Y <= ap.Y + as.Y
end

local function checkGodFunctions()
	local missing = {}
	if type(hookmetamethod) ~= "function" then table.insert(missing, "hookmetamethod") end
	if type(getnamecallmethod) ~= "function" then table.insert(missing, "getnamecallmethod") end
	if type(hookfunction) ~= "function" then table.insert(missing, "hookfunction") end
	if type(checkcaller) ~= "function" then table.insert(missing, "checkcaller") end
	if #missing > 0 then
		showNotification("Critical Functions missing: " .. table.concat(missing, ", ") .. ". Option may not work.", 5)
	end
	return #missing == 0
end

local function installGodHooks()
	if god.HooksInstalled or not AttemptToolUse then return end
	god.HooksInstalled = true

	-- Event:FireServer(...)
	if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" and type(newcclosure) == "function" then
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
			local self = ...
			if rawequal(self, AttemptToolUse) and getnamecallmethod() == "FireServer" then
				if godShouldBlock() then return end
			end
			return oldNamecall(...)
		end))
	end

	-- Event.FireServer(Event, ...)
	if type(hookfunction) == "function" then
		local oldFire
		oldFire = hookfunction(AttemptToolUse.FireServer, function(self, ...)
			if rawequal(self, AttemptToolUse) then
				if godShouldBlock() then return end
			end
			return oldFire(self, ...)
		end)
	end
end

local function godHitboxPart()
	if god.Hitbox and god.Hitbox.Parent then return god.Hitbox end
	local p = Instance.new("Part")
	p.Name = "LunarGodWeaponHitbox"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(god.Range * 2, god.Range * 2, god.Range * 2)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.ForceField
	p.Color = T.Warn
	p.Transparency = 0.8
	p.Parent = Workspace
	god.Hitbox = p
	return p
end

local function hookGodMobile()
	if not IS_MOBILE then return false end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("HUD")
	local mb = hud and hud:FindFirstChild("MobileButtons")
