	-- BUILDER PAGE
	------------------------------------------------
	do
		local p = PAGE.Builder
		sectionTitle(p, "Structure")

		local _, structBody = createExpandPanel(p, "Structure Settings", "Which model gets placed")
		createTextBox(structBody, "Structure Model Name", "e.g. Shelter", buildState.StructureName, function(v)
			buildState.StructureName = v
		end, "Name of the model to place")

		local vp = make("ViewportFrame", { Size = UDim2.new(1, 0, 0, 130), BackgroundColor3 = T.Field, Visible = false }, p)
		corner(vp, 8); stroke(vp, T.Stroke, 0.5)
		local vpCam = newViewportCamera(vp); vp.CurrentCamera = vpCam
		local vpWorld = make("WorldModel", {}, vp)
		local vpArrows = {}

		local function offsetVector()
			local o = buildState.AxisOffset
			return Vector3.new(o.X, o.Y, -5 + o.Z)
		end
		local function baseCFrame()
			return CFrame.new(offsetVector()) * CFrame.Angles(
				math.rad(buildState.Rotation.X), math.rad(buildState.Rotation.Y), math.rad(buildState.Rotation.Z))
		end

		local function refreshViewport()
			if buildState.ViewportViewModel then
				if buildState.ViewportViewModel:IsA("Model") then
					buildState.ViewportViewModel:PivotTo(baseCFrame())
				else
					buildState.ViewportViewModel.CFrame = baseCFrame()
				end
			end
			updateAxisArrows(vpArrows, baseCFrame(), buildState.VMSize or Vector3.new(4, 4, 4), 0.4)
		end

		local function setupViewport(name)
			vpWorld:ClearAllChildren()
			clearAxisArrows(vpArrows)
			vpArrows = createAxisArrows(vpWorld, 3)
			if LocalPlayer.Character then
				LocalPlayer.Character.Archivable = true
				local clone = LocalPlayer.Character:Clone()
				LocalPlayer.Character.Archivable = false
				clone.Parent = vpWorld
				if clone:IsA("Model") then clone:PivotTo(CFrame.new(0, 0, 0)) end
				buildState.ViewportCharModel = clone
			end
			local src = getStructureByName(name)
			if not src then
				vpCam.CFrame = CFrame.new(Vector3.new(7, 7, 7), Vector3.new(0, 1, -2.5)); return
			end
			local vm = src:Clone(); vm.Parent = vpWorld
			buildState.ViewportViewModel = vm
			if vm:IsA("Model") then
				local _, s = vm:GetBoundingBox(); buildState.VMSize = s
			elseif vm:IsA("BasePart") then
				buildState.VMSize = vm.Size
			end
			refreshViewport()
			vpCam.CFrame = CFrame.new(Vector3.new(7, 7, 7), Vector3.new(0, 1, -2.5))
		end

		sectionTitle(p, "Placement")

		local axisRow = make("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, p)
		local axisButtons = {}
		local holdUp, holdDown

		local function axisLabel(sign) return "Hold " .. sign .. buildState.SelectedAxis .. " Offset" end

		local function refreshAxisButtons()
			for b, a in pairs(axisButtons) do
				local on = (a == buildState.SelectedAxis)
				b.BackgroundColor3 = on and T.Accent or T.PanelD
				b.TextColor3 = on and T.Bg2 or T.Dim
			end
			if holdUp then holdUp.Text = axisLabel("+") end
			if holdDown then holdDown.Text = axisLabel("-") end
		end

		for i, ax in ipairs({ "X", "Y", "Z" }) do
			local b = make("TextButton", { Size = UDim2.new(0.31, 0, 1, 0), Position = UDim2.new((i - 1) * 0.345, 0, 0, 0),
				BackgroundColor3 = T.PanelD, Font = Enum.Font.GothamBold, Text = "Axis " .. ax,
				TextColor3 = T.Dim, TextSize = 10, ClipsDescendants = true }, axisRow)
			corner(b, 7); stroke(b, T.Stroke, 0.5)
			b.MouseButton1Down:Connect(function() ripple(b) end)
			b.MouseButton1Click:Connect(function()
				buildState.SelectedAxis = ax
				refreshAxisButtons(); refreshViewport()
				showNotification("Axis: " .. ax, 1.2)
			end)
			axisButtons[b] = ax
		end

		local ctrl = make("Frame", { Size = UDim2.new(1, 0, 0, 84), BackgroundTransparency = 1, Visible = false }, p)
		make("UIGridLayout", { CellSize = UDim2.new(0.48, 0, 0, 24), CellPadding = UDim2.new(0.04, 0, 0.08, 0) }, ctrl)

		local function gridBtn(text)
			local b = make("TextButton", { BackgroundColor3 = T.PanelD, Font = Enum.Font.GothamBold,
				Text = text, TextColor3 = T.Text, TextSize = 9, ClipsDescendants = true }, ctrl)
			corner(b, 7); stroke(b, T.Stroke, 0.5)
			b.MouseButton1Down:Connect(function() ripple(b) end)
			return b
		end

		holdUp = gridBtn(axisLabel("+")); holdDown = gridBtn(axisLabel("-"))
		local rotP = gridBtn("Rotate +"); local rotN = gridBtn("Rotate -")
		local resetOff = gridBtn("Reset Offsets")

		local function nudge(d)
			local ax = buildState.SelectedAxis
			buildState.AxisOffset[ax] = buildState.AxisOffset[ax] + d
			refreshViewport()
		end
		local holdAction
		local function startHold(fn) holdAction = fn; task.spawn(function() while holdAction == fn do fn(); task.wait(0.03) end end) end
		local function stopHold() holdAction = nil end

		holdUp.MouseButton1Down:Connect(function() startHold(function() nudge(0.15) end) end)
		holdUp.MouseButton1Up:Connect(stopHold); holdUp.MouseLeave:Connect(stopHold)
		holdDown.MouseButton1Down:Connect(function() startHold(function() nudge(-0.15) end) end)
		holdDown.MouseButton1Up:Connect(stopHold); holdDown.MouseLeave:Connect(stopHold)

		local function rotDelta(d)
			local r = buildState.Rotation
			if buildState.SelectedAxis == "X" then buildState.Rotation = Vector3.new((r.X + d) % 360, r.Y, r.Z)
			elseif buildState.SelectedAxis == "Y" then buildState.Rotation = Vector3.new(r.X, (r.Y + d) % 360, r.Z)
			else buildState.Rotation = Vector3.new(r.X, r.Y, (r.Z + d) % 360) end
			refreshViewport()
		end
		rotP.MouseButton1Down:Connect(function() startHold(function() rotDelta(3) end) end)
		rotP.MouseButton1Up:Connect(stopHold); rotP.MouseLeave:Connect(stopHold)
		rotN.MouseButton1Down:Connect(function() startHold(function() rotDelta(-3) end) end)
		rotN.MouseButton1Up:Connect(stopHold); rotN.MouseLeave:Connect(stopHold)

		resetOff.MouseButton1Click:Connect(function()
			buildState.AxisOffset = { X = 0, Y = 0, Z = 0 }
			refreshViewport()
			showNotification("All axis offsets reset", 1.4)
		end)

		local worldArrows = {}
		local function updateBox()
			if not buildState.BoundingBoxPart then return end
			local ch = LocalPlayer.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
			local cf = hrp.CFrame * baseCFrame()
			buildState.BoundingBoxPart.CFrame = cf
			updateAxisArrows(worldArrows, cf, buildState.BoundingBoxPart.Size, 0.4)
		end

		local function cancelBuild()
			if buildState.BoundingBoxPart then buildState.BoundingBoxPart:Destroy(); buildState.BoundingBoxPart = nil end
			if buildState.RenderConnection then buildState.RenderConnection:Disconnect(); buildState.RenderConnection = nil end
			clearAxisArrows(worldArrows); worldArrows = {}
			buildState.IsConstructing = false
			vp.Visible = false; ctrl.Visible = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
		uiRefs.cancelBuild = cancelBuild

		local function startBuild()
			local nm = buildState.StructureName
			if not nm or nm == "" then showNotification("Enter a structure name!", 1.6); return end
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
			Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom

			local src = getStructureByName(nm)
			local size = Vector3.new(4, 4, 4)
			if src then
				if src:IsA("Model") then local _, s = src:GetBoundingBox(); size = s
				elseif src:IsA("BasePart") then size = src.Size end
			end
			if buildState.BoundingBoxPart then buildState.BoundingBoxPart:Destroy() end
			local box = make("Part", { Name = "StructurePlacementBox", Size = size, Color = T.Good,
				Material = Enum.Material.SmoothPlastic, Transparency = 0.55, CanCollide = false, CanQuery = false,
				CanTouch = false, CastShadow = false, Massless = true, Anchored = true }, Workspace)
			buildState.BoundingBoxPart = box
			buildState.IsConstructing = true
			worldArrows = createAxisArrows(Workspace, 4)
			setupViewport(nm)
			vp.Visible = true; ctrl.Visible = true
			if buildState.RenderConnection then buildState.RenderConnection:Disconnect() end
			buildState.RenderConnection = RunService.RenderStepped:Connect(updateBox)
			showNotification("Constructing: " .. nm, 1.5)
		end

		local function placeBuild()
			local ch = LocalPlayer.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
			local cf = hrp.CFrame * baseCFrame()
			if BuildPlaceRemote then
				BuildPlaceRemote:FireServer(cf.Position, buildState.StructureName, buildState.Rotation.Y)
				showNotification("Placed " .. buildState.StructureName, 1.4)
			end
			cancelBuild()
		end

		local actRow = make("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, p)
		local function actBtn(text, x, col, fn, tip)
			local b = make("TextButton", { Size = UDim2.new(0.31, 0, 1, 0), Position = UDim2.new(x, 0, 0, 0),
				BackgroundColor3 = col, Font = Enum.Font.GothamBold, Text = text, TextColor3 = T.Text,
				TextSize = 10, ClipsDescendants = true }, actRow)
			corner(b, 7); local s = stroke(b, T.Stroke, 0.4); hover(b, col, T.Hover, s)
			if tip then addTooltip(b, tip) end
			b.MouseButton1Down:Connect(function() ripple(b) end)
			b.MouseButton1Click:Connect(function() fn() end)
		end
		actBtn("Construct", 0, Color3.fromRGB(38, 166, 91), startBuild, "Show the placement preview")
		actBtn("Build", 0.345, Color3.fromRGB(41, 128, 185), placeBuild, "Place the structure")
		actBtn("Cancel", 0.69, Color3.fromRGB(192, 57, 43), cancelBuild, "Hide the preview")

		sectionTitle(p, "Concurrent Build")

		local previewFolder = make("Folder", { Name = "V_ConcurrentPreview" }, Workspace)
		local previewLine = make("Part", { Name = "PreviewLine", Anchored = true, CanCollide = false, CanQuery = false,
			CastShadow = false, Material = Enum.Material.Neon, Color = T.Accent, Transparency = 1, Size = Vector3.new(0.25, 0.25, 1) }, previewFolder)
		local previewGhost = make("Part", { Name = "PreviewGhost", Anchored = true, CanCollide = false, CanQuery = false,
			CastShadow = false, Material = Enum.Material.ForceField, Color = T.Accent2, Transparency = 1, Size = Vector3.new(3, 3, 3) }, previewFolder)

		local pathParts = {}
		local function clearPathPreview()
			for _, part in ipairs(pathParts) do part:Destroy() end
			pathParts = {}
		end
		local function refreshPathPreview(path)
			local need = math.max(#path - 1, 0)
			while #pathParts < need do
				local part = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CastShadow = false,
					Material = Enum.Material.Neon, Color = T.Accent2, Transparency = 0.45, Size = Vector3.new(0.22, 0.22, 1) }, previewFolder)
				table.insert(pathParts, part)
			end
			for i = 1, need do
				local a, b = path[i], path[i + 1]
				local d = math.max((b - a).Magnitude, 0.05)
				pathParts[i].Size = Vector3.new(0.22, 0.22, d)
				pathParts[i].CFrame = CFrame.lookAt(a + (b - a) / 2, b)
				pathParts[i].Transparency = 0.45
			end
			for i = need + 1, #pathParts do pathParts[i].Transparency = 1 end
		end
		local function showPreview(a, b)
			local dist = math.max((b - a).Magnitude, 0.1)
			previewLine.Size = Vector3.new(0.25, 0.25, dist)
			previewLine.CFrame = CFrame.lookAt(a + (b - a) / 2, b)
			previewLine.Transparency = 0.35
			previewGhost.CFrame = CFrame.new(b)
			previewGhost.Transparency = 0.5
		end
		local function hidePreview()
			previewLine.Transparency = 1
			previewGhost.Transparency = 1
		end

		local function drawAlongPath(path)
			local nm = buildState.StructureName
			if not BuildPlaceRemote or nm == "" then showNotification("No structure selected!", 1.6); return end
			local step = math.max(concurrent.PerStuds, concurrent.Spacing, 1)
			showNotification("Multi Line drawing...", 1.2)
			task.spawn(function()
				local placed, carry = 0, 0
				for i = 1, #path - 1 do
					local a, b = path[i], path[i + 1]
					local segLen = (b - a).Magnitude
					if segLen > 0.01 then
						local dist = carry
						while dist <= segLen do
							local pos = a:Lerp(b, dist / segLen)
							if concurrent.GroundSnap then pos = groundSnap(pos) end
							BuildPlaceRemote:FireServer(pos, nm, buildState.Rotation.Y)
							placed += 1
							if placed % 8 == 0 then RunService.Heartbeat:Wait() end
							dist += step
						end
						carry = dist - segLen
					end
				end
				showNotification("Multi Line: " .. placed .. "x " .. nm, 1.5)
			end)
		end

		createToggleKeybind(p, "Concurrent Mode", concurrent.Active, function(v)
			concurrent.Active = v
			concurrent.Holding = false
			concurrent.StartPos = nil
			concurrent.Path = {}
			clearPathPreview(); hidePreview()
			showNotification(v and "Concurrent ON - drag to preview" or "Concurrent OFF", 1.6)
		end, Enum.KeyCode.Unknown, "Drag to preview a line, then confirm to build it")

		local _, concurrentBody = createExpandPanel(p, "Concurrent Settings", "Ground snap, spacing, range and multi line")
		createToggle(concurrentBody, "Ground Snap", concurrent.GroundSnap, function(v) concurrent.GroundSnap = v end,
			"Drop each placed structure onto the ground", false)
		createSlider(concurrentBody, "Structure Per Studs", 1, 60, concurrent.PerStuds, 1, function(v) concurrent.PerStuds = v end, "One structure placed every N studs")
		createSlider(concurrentBody, "Min Structure Spacing", 1, 40, concurrent.Spacing, 1, function(v) concurrent.Spacing = v end, "Floor for the spacing")
		createSlider(concurrentBody, "Concurrent Range", 50, 2000, concurrent.MaxRange, 10, function(v) concurrent.MaxRange = v end, "Max reach from your character")
		createToggleKeybind(concurrentBody, "Multi Line Mode", concurrent.MultiLine, function(v)
			concurrent.MultiLine = v
			concurrent.Path = {}
			clearPathPreview(); hidePreview()
			showNotification(v and "Multi Line ON" or "Multi Line OFF", 1.5)
		end, Enum.KeyCode.Unknown, "Curved dragging — middle mouse also toggles this")

		if IS_MOBILE then
			createToggle(concurrentBody, "Auto Sweep (mobile)", concurrent.Auto, function(v)
				concurrent.Auto = v
				showNotification(v and "Auto Sweep ON" or "Auto Sweep OFF", 1.6)
			end, "Places along your crosshair as you move", false)
		end

		local function askConfirm(a, b, path)
			local old = gui:FindFirstChild("DrawConfirm"); if old then old:Destroy() end
			local isPath = path ~= nil
			local f = make("Frame", { Name = "DrawConfirm", Size = UDim2.new(0, 300, 0, 0),
				Position = UDim2.new(0.5, -150, 1, -110), BackgroundColor3 = T.Bg1,
				BorderSizePixel = 0, ZIndex = 80, ClipsDescendants = true }, gui)
			corner(f, 10); stroke(f, T.Accent, 0.2, 1.5)
			TweenService:Create(f, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 300, 0, 74) }):Play()
			make("TextLabel", { Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 12, 0, 8), BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold, Text = isPath and ("Draw this line? (" .. #path .. " pts)") or "Draw this line?",
				TextColor3 = T.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left }, f)
			local br = make("Frame", { Size = UDim2.new(1, -24, 0, 30), Position = UDim2.new(0, 12, 0, 38), BackgroundTransparency = 1 }, f)
			local function mk(text, x, col, fn)
				local btn = make("TextButton", { Size = UDim2.new(0.48, 0, 1, 0), Position = UDim2.new(x, 0, 0, 0),
					BackgroundColor3 = col, Font = Enum.Font.GothamBold, Text = text, TextColor3 = T.Text,
					TextSize = 11, AutoButtonColor = false, ClipsDescendants = true }, br)
				corner(btn, 8); local s = stroke(btn, T.Stroke, 0.4); hover(btn, col, T.Hover, s)
				btn.MouseButton1Down:Connect(function() ripple(btn) end)
				btn.MouseButton1Click:Connect(function() playClick(); f:Destroy(); fn() end)
			end
			mk("Draw", 0, Color3.fromRGB(38, 130, 75), function()
				local nm = buildState.StructureName
				if not BuildPlaceRemote or nm == "" then return end
				if isPath then
					clearPathPreview(); hidePreview(); drawAlongPath(path)
				else
					local step = math.max(concurrent.PerStuds, concurrent.Spacing, 1)
					local count = math.clamp(math.floor((b - a).Magnitude / step) + 1, 1, 400)
					showNotification("Drawing " .. count .. "x " .. nm, 1.5)
					task.spawn(function()
						for i = 0, count - 1 do
							local p3 = a:Lerp(b, count == 1 and 0 or i / (count - 1))
							if concurrent.GroundSnap then p3 = groundSnap(p3) end
							BuildPlaceRemote:FireServer(p3, nm, buildState.Rotation.Y)
							if i % 8 == 0 then RunService.Heartbeat:Wait() end
						end
					end)
					hidePreview()
				end
			end)
			mk("Cancel", 0.52, Color3.fromRGB(150, 55, 55), function() hidePreview(); clearPathPreview() end)
		end

		UserInputService.InputBegan:Connect(function(i, gp)
			if gp or not concurrent.Active then return end
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				local pos = getClickPosition()
				concurrent.Holding = true
				concurrent.StartPos = pos
				concurrent.CurrPos = pos
				if concurrent.MultiLine then
					concurrent.Path = { pos }
					clearPathPreview(); refreshPathPreview(concurrent.Path); hidePreview()
				end
			end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				if concurrent.Holding and concurrent.StartPos then
					concurrent.Holding = false
					if concurrent.MultiLine then
						local path = concurrent.Path
						concurrent.Path = {}
						if #path >= 2 then askConfirm(nil, nil, path)
						else clearPathPreview(); hidePreview() end
					else
						local a, b = concurrent.StartPos, concurrent.CurrPos or concurrent.StartPos
						if (b - a).Magnitude > 1 then askConfirm(a, b) else hidePreview() end
					end
				end
			end
		end)

		RunService.Heartbeat:Connect(function()
			if not concurrent.Active then return end
			if concurrent.Holding and concurrent.StartPos then
				local pos = getClickPosition()
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if hrp and (pos - hrp.Position).Magnitude <= concurrent.MaxRange then
					concurrent.CurrPos = pos
					if concurrent.MultiLine then
						local path = concurrent.Path
						local last = path[#path]
						if not last or (pos - last).Magnitude >= 1.5 then
							table.insert(path, pos)
							refreshPathPreview(path)
						end
					else
						showPreview(concurrent.StartPos, pos)
					end
				end
			elseif concurrent.Auto then
				local pos = getCenterPosition()
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if hrp and (pos - hrp.Position).Magnitude <= concurrent.MaxRange then
					local step = math.max(concurrent.PerStuds, 1)
					if not concurrent.StartPos or (pos - concurrent.StartPos).Magnitude >= step then
						concurrent.StartPos = pos
						local nm = buildState.StructureName
						if BuildPlaceRemote and nm ~= "" then
							BuildPlaceRemote:FireServer(concurrent.GroundSnap and groundSnap(pos) or pos, nm, buildState.Rotation.Y)
						end
					end
				end
			end
		end)
	end

