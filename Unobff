		local STATS_FILE = SAVE_FOLDER .. "/itemstats.json"
		local STATS_FALLBACK = "LunarMenu_itemstats.json"

		local statsSnapshot = nil

		local function snapshotAllStats()
			statsSnapshot = {}
			for name, data in pairs(ItemStats) do
				if type(data) == "table" then statsSnapshot[name] = copyValue(data) end
			end
		end

		local function restoreAllStats()
			if not statsSnapshot then showNotification("Nothing to revert", 1.4); return end
			for name, data in pairs(statsSnapshot) do
				local live = ItemStats[name]
				if type(live) == "table" then
					for k in pairs(live) do live[k] = nil end
					for k, v in pairs(data) do live[k] = copyValue(v) end
				else
					ItemStats[name] = copyValue(data)
				end
			end
			showNotification("All item stats reverted", 1.5)
		end

		local function saveAllStats()
			if not HAS_FS then showNotification("Executor has no file functions", 2); return end
			local payload = {}
			for name, data in pairs(ItemStats) do
				if type(data) == "table" then
					local flat = {}
					for k, v in pairs(data) do flat[tostring(k)] = serializeValue(v) end
					payload[tostring(name)] = flat
				end
			end
			local ok, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
			if not ok or not encoded then showNotification("Encode failed", 1.6); return end
			local target = ensureSaveFolder() and STATS_FILE or STATS_FALLBACK
			local wrote = pcall(function() writefile(target, encoded) end)
			if not wrote then wrote = pcall(function() writefile(STATS_FALLBACK, encoded) end) end
			if wrote then
				snapshotAllStats()
				showNotification("Item stats saved to disk", 1.6)
			else
				showNotification("Save failed", 1.6)
			end
		end

