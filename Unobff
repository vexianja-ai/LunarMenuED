local function promptInstant(prompt)
	pcall(function() prompt.HoldDuration = 0 end)
end

local function autoCompleteStructure(model)
	local name = model.Name
	if AUTO_SKIP[name] then return 0, true end
	local holder = model:FindFirstChild("prompt")
	local prompt = holder and holder:FindFirstChild("ProximityPrompt")
	if not prompt then return 0, false end
	promptInstant(prompt)

	local rounds = autoRoundsFor(name)
	local fired = 0
	for _ = 1, 60 do
		local idx = model:GetAttribute("CurrentStageIndex")
		if idx == nil or not model.Parent then break end
		local stageName = "Stage" .. (idx + 1)
		pcall(function() prompt:InputHoldBegin() end)
		pcall(function() prompt:InputHoldEnd() end)
		for _ = 1, rounds do
			for _, mat in ipairs(AUTO_MATERIALS) do
				if BuildBlueprintAdd then
					BuildBlueprintAdd:FireServer("can", stageName, mat)
					fired += 1
				end
			end
		end
		task.wait(0.06)
	end
	return fired, true
end

local function autoCompleteNear()
	local ch = LocalPlayer.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then showNotification("No character!", 1.4); return end
	local root = Workspace:FindFirstChild("Interactables")
	local folder = root and root:FindFirstChild("Structures")
	if not folder then showNotification("No structures found", 1.5); return end

	local list = {}
	for _, m in ipairs(folder:GetDescendants()) do
		if m:IsA("Model") and m.PrimaryPart and m:GetAttribute("CurrentStageIndex") ~= nil
			and not AUTO_SKIP[m.Name] then
			local holder = m:FindFirstChild("prompt")
			local prompt = holder and holder:FindFirstChild("ProximityPrompt")
			if prompt then
				local reach = (prompt.MaxActivationDistance or 10) + 6
				if (m.PrimaryPart.Position - hrp.Position).Magnitude <= reach then
					table.insert(list, m)
				end
			end
		end
	end
	if #list == 0 then showNotification("No incomplete structures nearby", 1.8); return end

	showNotification("Auto completing " .. #list .. " structure(s)...", 2)
	autoCompleteBurst = true
	task.spawn(function()
		local done, total = 0, 0
		for _, m in ipairs(list) do
			local fired = autoCompleteStructure(m)
			total += fired
			done += 1
		end
		task.wait(0.3)
		autoCompleteBurst = false
		showNotification("Auto complete: " .. done .. " structure(s), " .. total .. " remote(s)", 1.8)
	end)
end

