local function espText(plr, char)
	local parts = {}
	if espTeamColors and plr.Team then table.insert(parts, "[" .. plr.Team.Name .. "]") end
	table.insert(parts, plr.DisplayName .. " (@" .. plr.Name .. ")")
	local txt = table.concat(parts, "  ")
	if espShowHealth then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then txt = txt .. "  " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
	end
	return txt
end

local function removeESP(character, tag)
	if character:FindFirstChild(tag .. "_Highlight") then character[tag .. "_Highlight"]:Destroy() end
	if character:FindFirstChild(tag .. "_Billboard") then character[tag .. "_Billboard"]:Destroy() end
end

local function clearAllESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then removeESP(plr.Character, "PlayerESP") end
	end
	local folder = Workspace:FindFirstChild("Animals")
	local scan = folder or Workspace
	for _, d in ipairs(scan:GetDescendants()) do
		if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") then removeESP(d, "AnimalESP") end
	end
end

