	local AXIS_DEFS = {
		{dir = Vector3.new(1, 0, 0), color = Color3.fromRGB(255, 70, 70), text = "+X", rot = CFrame.Angles(0, math.rad(90), 0)},
		{dir = Vector3.new(-1, 0, 0), color = Color3.fromRGB(170, 40, 40), text = "-X", rot = CFrame.Angles(0, math.rad(90), 0)},
		{dir = Vector3.new(0, 1, 0), color = Color3.fromRGB(70, 255, 130), text = "+Y", rot = CFrame.Angles(math.rad(-90), 0, 0)},
		{dir = Vector3.new(0, -1, 0), color = Color3.fromRGB(40, 170, 80), text = "-Y", rot = CFrame.Angles(math.rad(-90), 0, 0)},
		{dir = Vector3.new(0, 0, 1), color = Color3.fromRGB(90, 150, 255), text = "+Z", rot = CFrame.Angles(0, 0, 0)},
		{dir = Vector3.new(0, 0, -1), color = Color3.fromRGB(50, 80, 180), text = "-Z", rot = CFrame.Angles(0, 0, 0)},
	}
	local function createAxisArrows(parent, length)
		local arrows = {}
		for _, d in ipairs(AXIS_DEFS) do
			local part = Instance.new("Part")
			part.Name = "Axis_" .. d.text
			part.Anchored = true; part.CanCollide = false; part.CanQuery = false; part.CastShadow = false
			part.Material = Enum.Material.Neon; part.Size = Vector3.new(0.09, 0.09, length); part.Color = d.color
			part.Parent = parent
			local bb = make("BillboardGui", { Size = UDim2.new(0, 26, 0, 14), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 0.35, 0) }, part)
			make("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = d.text,
				TextColor3 = d.color, TextStrokeTransparency = 0, Font = Enum.Font.GothamBold, TextSize = 10 }, bb)
			table.insert(arrows, { part = part, dir = d.dir, rot = d.rot })
		end
		return arrows
	end
	local function updateAxisArrows(arrows, baseCF, baseSize, clearance)
		local ext = math.min(baseSize.X, baseSize.Y, baseSize.Z) * 0.5 + (clearance or 0.5)
		for _, a in ipairs(arrows) do
			if a.part.Parent then
				a.part.CFrame = baseCF * CFrame.new(a.dir * (ext + a.part.Size.Z * 0.5)) * a.rot
			end
		end
	end
	local function clearAxisArrows(arrows)
		for _, a in ipairs(arrows) do a.part:Destroy() end
	end

