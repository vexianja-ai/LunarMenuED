				ZIndex = 4, TextStrokeTransparency = 0.55, TextStrokeColor3 = Color3.new(0, 0, 0) }, keyBtn)
			make("UITextSizeConstraint", { MaxTextSize = 9, MinTextSize = 5 }, keyTxt)

			keybinds[label] = keybinds[label] or defaultKey or Enum.KeyCode.Unknown
			keyRefs[label] = { btn = keyBtn, txt = keyTxt }
			refreshKeyVisual(label)

			keyBtn.MouseButton1Down:Connect(function() ripple(keyBtn) end)
			keyBtn.MouseButton1Click:Connect(function() playClick(); beginListen(label) end)
			keyBtn.MouseButton2Click:Connect(function()
				keybinds[label] = Enum.KeyCode.Unknown
				refreshKeyVisual(label)
				saveConfig()
				showNotification("Cleared keybind: " .. label, 1.4)
			end)
			addTooltip(keyBtn, "Click to bind a key  •  Right-click to clear")
		end

		local state = initial
		local function refresh(animate)
			local ti = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			local target = { BackgroundColor3 = state and Color3.fromRGB(38, 120, 70) or Color3.fromRGB(40, 46, 70) }
			local kp = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
			local kc = state and T.Good or Color3.fromRGB(200, 210, 235)
			if animate then
				TweenService:Create(track, ti, target):Play()
				TweenService:Create(knob, ti, { Position = kp, BackgroundColor3 = kc }):Play()
				TweenService:Create(ts, ti, { Color = state and T.Good or T.Stroke, Transparency = state and 0.2 or 0.5 }):Play()
			else
				track.BackgroundColor3 = target.BackgroundColor3
				knob.Position = kp; knob.BackgroundColor3 = kc
			end
		end

		local api = {}
		function api.toggle()
			state = not state; refresh(true); playClick()
			if onChange then onChange(state) end
			saveConfig()
		end
		function api.get() return state end
		function api.set(v, silent)
			if state == v then return end
			state = v; refresh(true)
			if onChange and not silent then onChange(state) end
		end

		row.MouseButton1Down:Connect(function() ripple(row) end)
		row.MouseButton1Click:Connect(function()
			if keyBtn and keyBtn.Parent then
				local mp = UserInputService:GetMouseLocation()
				local ap, as = keyBtn.AbsolutePosition, keyBtn.AbsoluteSize
				if mp.X >= ap.X and mp.X <= ap.X + as.X and mp.Y >= ap.Y and mp.Y <= ap.Y + as.Y then return end
			end
			api.toggle()
		end)

		if tip then addTooltip(row, tip) end
		keyTriggers[label] = api.toggle
		refresh(false)
		if register ~= false then toggleRefs[label] = api end
		return api
	end

