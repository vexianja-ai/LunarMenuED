local function waitChild(parent, ...)
	local node = parent
	for i = 1, select("#", ...) do
		if not node then return nil end
		local name = select(i, ...)
		local child = node:FindFirstChild(name)
		if not child then
			local ok, res = pcall(function() return node:WaitForChild(name, 10) end)
			child = ok and res or nil
		end
		node = child
	end
	return node
end

local function safeRequire(parent, ...)
	local node = waitChild(parent, ...)
	if not node then return nil end
	local ok, mod = pcall(require, node)
	if not ok then return nil end
	return mod
end

