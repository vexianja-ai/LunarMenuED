	if targetCharacter and SpearReplicationHit then
		local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		SpearReplicationHit:FireServer({
			position = hitPos, cframe = CFrame.new(hitPos),
			hitPart = headOrTorso or hitInstance,
			startPosition = hitPos + Vector3.new(0, 10, 0)
		}, currentThrowableName, targetHumanoid)
