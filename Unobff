local originalCreateSpear = Framework.create_spear
Framework.create_spear = function(item, char, startPos, targetPos, noRepl)
	if not (spearMode.visualOnly or spearMode.noVisual) then
		return originalCreateSpear(item, char, startPos, targetPos, noRepl)
	end
	ensureHookSupport()
	if spearMode.noVisual then spawnTracer(startPos, targetPos); return end
	if not noRepl and ThrownSpearReplication then
		local fromUs = checkcaller and checkcaller() or true
		if fromUs then ThrownSpearReplication:FireServer(item, char, startPos, targetPos) end
	end
	return originalCreateSpear(item, char, startPos, targetPos, spearMode.visualOnly and true or noRepl)
end

if hookmetamethod and getnamecallmethod and newcclosure then
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if getnamecallmethod() == "FireServer" and typeof(self) == "Instance"
			and self.Name == "SpearReplicationHit" and spearMode.visualOnly then
			return
		end
		return oldNamecall(self, ...)
	end))
end

-- blueprint interceptor: keep every argument, swap only "not" -> "can"
if BuildBlueprintAdd and type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
	local oldNC
	oldNC = hookmetamethod(game, "__namecall", wrapClosure(function(self, ...)
		if (autoCompleteStructures or autoCompleteBurst)
			and rawequal(self, BuildBlueprintAdd) and getnamecallmethod() == "FireServer" then
			local args = table.pack(...)
			if args[1] == "not" then
				args[1] = "can"
				return oldNC(table.unpack(args, 1, args.n))
			end
		end
		return oldNC(self, ...)
	end))
end

local function killConnections(signal)
	if not getconnections then return false end
	local ok, conns = pcall(getconnections, signal)
	if not ok or not conns then return false end
	for _, c in ipairs(conns) do
		if type(c.Disable) == "function" then pcall(function() c:Disable() end)
		elseif type(c.Disconnect) == "function" then pcall(function() c:Disconnect() end)
		elseif type(c.disconnect) == "function" then pcall(function() c:disconnect() end) end
	end
	return true
end

if ThrownSpearReplication and killConnections(ThrownSpearReplication.OnClientEvent) then
	ThrownSpearReplication.OnClientEvent:Connect(function(item, char, startPos, aimVec)
		if not char or char.Name == LocalPlayer.Name then return end
		if spearMode.noVisual then spawnTracer(startPos, aimVec)
		else originalCreateSpear(item, char, startPos, aimVec, true) end
	end)
end

