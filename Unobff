	------------------------------------------------
	-- PAGES
	------------------------------------------------
	local pageNames = { "General", "Item", "Builder", "Miscellaneous", "Settings" }
	local pages, pageGroups, navBtns, navBars = {}, {}, {}, {}

	for i, name in ipairs(pageNames) do
		local grp = make("CanvasGroup", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Visible = (name == currentPageName), GroupTransparency = 0 }, content)
		local page = make("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 4, ScrollBarImageColor3 = T.Accent }, grp)
		make("UIListLayout", { Padding = UDim.new(0, 11), SortOrder = Enum.SortOrder.LayoutOrder }, page)
		make("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 18), PaddingBottom = UDim.new(0, 24) }, page)
		make("TextLabel", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
			Text = string.upper(name) .. " MODULE", TextColor3 = T.Text, TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left }, page)
		pages[name] = page
		pageGroups[name] = grp
	end

	local function goToPage(name)
		if not pages[name] then return end
		currentPageName = name
		for pn, g in pairs(pageGroups) do
			if pn == name then
				g.Visible = true
				g.GroupTransparency = 1
				TweenService:Create(g, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { GroupTransparency = 0 }):Play()
			else
				g.Visible = false
			end
		end
		for pn, o in pairs(navBtns) do
			TweenService:Create(o, TweenInfo.new(0.2), { BackgroundTransparency = 0.6, TextColor3 = T.Dim }):Play()
			TweenService:Create(navBars[pn], TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Size = UDim2.new(0, 3, 0, 0), Position = UDim2.new(0, 0, 0.5, 0) }):Play()
		end
