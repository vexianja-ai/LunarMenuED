local function showLoadingScreen(onDone)
	local old = UI_PARENT:FindFirstChild("LunarLoading"); if old then old:Destroy() end

	local sg = make("ScreenGui", { Name = "LunarLoading", ResetOnSpawn = false,
		IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100 }, UI_PARENT)

	local WHITE = Color3.new(1, 1, 1)
	local duration = 9 + math.random() * 3

	local done = false
	local function finish()
		if done then return end
		done = true
		if sg and sg.Parent then sg:Destroy() end
		if onDone then task.spawn(onDone) end
	end
	task.delay(duration + 14, finish)

	local function tween(obj, tinfo, props)
		if not obj or not obj.Parent then return end
		pcall(function() TweenService:Create(obj, tinfo, props):Play() end)
	end

	local CW, CH = 400, 232

	local cardGlow = make("Frame", { Size = UDim2.fromOffset(CW + 26, CH + 26), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.86,
		BorderSizePixel = 0, ZIndex = 1 }, sg)
	corner(cardGlow, 26)

	local card = make("Frame", { Size = UDim2.fromOffset(CW, CH), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 14), BackgroundColor3 = T.Bg2, BorderSizePixel = 0,
		ClipsDescendants = true, ZIndex = 2 }, sg)
	corner(card, 16)
	local cardStroke = stroke(card, T.Accent, 0.35, 1.5)
	themeGradient(card, "Bg1", "Bg2", 135)
	tween(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0.5, 0, 0.5, 0) })

	local fadeList = {}
	local rings = {}
	for i, cfg in ipairs({ { 76, 6.0, T.Accent }, { 104, -4.0, T.Accent2 } }) do
		local size = cfg[1]
		local ring = make("Frame", { Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, 54), BackgroundTransparency = 1, Rotation = 45 + (i - 1) * 26, ZIndex = 3 }, card)
		corner(ring, math.floor(size * 0.18))
		local s = Instance.new("UIStroke")
		s.Color = cfg[3]; s.Thickness = 1; s.Transparency = 0.78
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Parent = ring
		table.insert(rings, { ring = ring, stroke = s, speed = cfg[2] })
	end

	local logoGlow = make("Frame", { Size = UDim2.fromOffset(64, 64), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 54), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.84, ZIndex = 3 }, card)
	corner(logoGlow, 999)

	local logo = make("ImageLabel", { Size = UDim2.fromOffset(46, 46), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 54), BackgroundTransparency = 1, Image = LOGO_ID,
		ImageTransparency = 1, ZIndex = 4 }, card)

	local title = make("TextLabel", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, 92),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "L U N A R", TextColor3 = WHITE,
		TextSize = 22, TextTransparency = 1, ZIndex = 4 }, card)

	local status = make("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 0, 120),
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = "Initializing...", TextColor3 = WHITE,
		TextSize = 11, TextTransparency = 1, ZIndex = 4 }, card)

	local barBg = make("Frame", { Size = UDim2.new(0, 268, 0, 3), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 152), BackgroundColor3 = Color3.fromRGB(40, 44, 66),
		BorderSizePixel = 0, ZIndex = 4 }, card)
	corner(barBg, 99)
	local barFill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, barBg)
	corner(barFill, 99)
	themeGradient(barFill, "Accent", "Accent2")
	local shimmer = make("Frame", { Size = UDim2.new(0, 50, 1, 0), Position = UDim2.new(0, -50, 0, 0),
		BackgroundColor3 = WHITE, BackgroundTransparency = 0.5, BorderSizePixel = 0 }, barFill)

	local percent = make("TextLabel", { Size = UDim2.new(0, 60, 0, 14), Position = UDim2.new(0.5, -30, 0, 162),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "0%", TextColor3 = WHITE,
		TextSize = 10, TextTransparency = 1, ZIndex = 4 }, card)

	local credit = make("TextLabel", { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 198),
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = "developed by v3x  •  " .. VERSION,
		TextColor3 = WHITE, TextSize = 9, TextTransparency = 1, ZIndex = 4 }, card)

	fadeList = {
		{ title, "TextTransparency" }, { status, "TextTransparency" }, { percent, "TextTransparency" },
		{ credit, "TextTransparency" }, { logo, "ImageTransparency" }, { logoGlow, "BackgroundTransparency" },
		{ barBg, "BackgroundTransparency" }, { barFill, "BackgroundTransparency" }, { shimmer, "BackgroundTransparency" },
	}

	tween(logo, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { ImageTransparency = 0 })
	tween(title, TweenInfo.new(0.8), { TextTransparency = 0 })
	tween(status, TweenInfo.new(0.8), { TextTransparency = 0 })
	tween(percent, TweenInfo.new(0.8), { TextTransparency = 0 })
	tween(credit, TweenInfo.new(1.3), { TextTransparency = 0.3 })

	task.spawn(function()
		while sg.Parent do
			local dt = RunService.RenderStepped:Wait()
			for _, r in ipairs(rings) do
				if r.ring.Parent then r.ring.Rotation = (r.ring.Rotation + r.speed * dt) % 360 end
			end
		end
	end)
	task.spawn(function()
		while sg.Parent do
			tween(logoGlow, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ BackgroundTransparency = 0.92, Size = UDim2.fromOffset(72, 72) })
			task.wait(1.6)
			tween(logoGlow, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ BackgroundTransparency = 0.8, Size = UDim2.fromOffset(62, 62) })
			task.wait(1.6)
		end
	end)
	task.spawn(function()
		while sg.Parent do
			shimmer.Position = UDim2.new(0, -50, 0, 0)
			tween(shimmer, TweenInfo.new(1.5, Enum.EasingStyle.Linear), { Position = UDim2.new(1, 10, 0, 0) })
			task.wait(2.0)
		end
	end)

	local stages = {
		{ 0.00, "Fetching Modules..." }, { 0.15, "Resolving Remotes..." }, { 0.30, "Applying Hooks..." },
		{ 0.48, "Loading Item Stats..." }, { 0.63, "Indexing Throwables..." },
		{ 0.78, "Building Interface..." }, { 0.90, "Loading UI..." }, { 0.97, "Ready" },
	}
	local lastStage = 0

	task.spawn(function()
		local ok, err = pcall(function()
			local t0 = tick()
			while not done do
				local a = math.clamp((tick() - t0) / duration, 0, 1)
				local eased = 1 - (1 - a) * (1 - a)
				barFill.Size = UDim2.new(eased, 0, 1, 0)
				percent.Text = string.format("%d%%", math.floor(eased * 100))
				for i = #stages, 1, -1 do
					if a >= stages[i][1] then
						if i ~= lastStage then
							lastStage = i
							status.Text = stages[i][2]
							status.TextTransparency = 1
							tween(status, TweenInfo.new(0.25), { TextTransparency = 0 })
						end
						break
					end
				end
				if a >= 1 then break end
				RunService.RenderStepped:Wait()
			end
			status.Text = "Ready"
			tween(status, TweenInfo.new(0.3), { TextTransparency = 0 })
			task.wait(0.45)
			for _, e in ipairs(fadeList) do tween(e[1], TweenInfo.new(0.45), { [e[2]] = 1 }) end
			for _, r in ipairs(rings) do
				tween(r.ring, TweenInfo.new(0.45), { BackgroundTransparency = 1 })
				tween(r.stroke, TweenInfo.new(0.45), { Transparency = 1 })
			end
			tween(cardStroke, TweenInfo.new(0.45), { Transparency = 1 })
			tween(cardGlow, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
			tween(card, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.new(0.5, 0, 0.5, -14), BackgroundTransparency = 1
			})
			task.wait(0.6)
		end)
		if not ok then warn("[Lunar] loading screen error: " .. tostring(err)) end
		finish()
	end)
end

