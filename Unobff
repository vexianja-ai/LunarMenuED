local function triggerMultiImpactFX(hitInstance, hitPos)
	local targetCharacter = hitInstance and hitInstance:FindFirstAncestorOfClass("Model")
	local headOrTorso = targetCharacter and (targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart"))
	for i = 1, 5 do
		task.spawn(function()
			if headOrTorso then Framework.FX_Blood(headOrTorso, 3)
