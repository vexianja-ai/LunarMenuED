		-- ALL axes that were modified are applied together (X + Y + Z), not just the selected one
		local function offsetVector()
			local o = buildState.AxisOffset
			return Vector3.new(o.X, o.Y, -5 + o.Z)
		end

		local function baseCFrame()
			return CFrame.new(offsetVector()) * CFrame.Angles(
				math.rad(buildState.Rotation.X), math.rad(buildState.Rotation.Y), math.rad(buildState.Rotation.Z))
		end

		local function refreshViewport()
			if buildState.ViewportViewModel then
				if buildState.ViewportViewModel:IsA("Model") then
					buildState.ViewportViewModel:PivotTo(baseCFrame())
				else
					buildState.ViewportViewModel.CFrame = baseCFrame()
				end
			end
