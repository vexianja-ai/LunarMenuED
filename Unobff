			end
			mk("Draw", 0, Color3.fromRGB(38, 130, 75), function()
				local nm = buildState.StructureName
				if not BuildPlaceRemote or nm == "" then return end
				if isPath then
					clearPathPreview(); hidePreview(); drawAlongPath(path)
				else
					local step = math.max(concurrent.PerStuds, concurrent.Spacing, 1)
					local count = math.clamp(math.floor((b - a).Magnitude / step) + 1, 1, 400)
					showNotification("Drawing " .. count .. "x " .. nm, 1.5)
					task.spawn(function()
						for i = 0, count - 1 do
							local p3 = a:Lerp(b, count == 1 and 0 or i / (count - 1))
							if concurrent.GroundSnap then p3 = groundSnap(p3) end
							BuildPlaceRemote:FireServer(p3, nm, buildState.Rotation.Y)
							if i % 8 == 0 then RunService.Heartbeat:Wait() end
						end
					end)
