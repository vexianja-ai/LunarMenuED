		local statsSnapshots = {}

		local function copyValue(v)
			if type(v) == "table" then
				local c = {}
				for k, x in pairs(v) do
					if type(x) == "table" then
						local c2 = {}
						for k2, x2 in pairs(x) do c2[k2] = x2 end
						c[k] = c2
					else
						c[k] = x
					end
				end
				return c
			end
			return v
		end

		local function serializeValue(v)
			local t = typeof(v)
			if t == "number" then return tostring(v)
			elseif t == "string" then return v
			elseif t == "boolean" then return tostring(v)
			elseif t == "Vector3" then return string.format("%g, %g, %g", v.X, v.Y, v.Z)
			elseif t == "table" then
				local isArray = true
				for k in pairs(v) do if type(k) ~= "number" then isArray = false; break end end
				local parts = {}
				if isArray then
					for _, x in ipairs(v) do table.insert(parts, tostring(x)) end
					return table.concat(parts, ", ")
				end
				for k, x in pairs(v) do
					if type(x) == "table" then
						local inner = {}
						for _, y in ipairs(x) do table.insert(inner, tostring(y)) end
						table.insert(parts, tostring(k) .. "=" .. table.concat(inner, "|"))
					else
						table.insert(parts, tostring(k) .. "=" .. tostring(x))
					end
				end
				return table.concat(parts, "; ")
			end
			return tostring(v)
		end

		local function parseValue(text, original)
			local t = typeof(original)
			if t == "number" then return tonumber(text) or original end
			if t == "boolean" then
				local lt = text:lower()
				if lt == "true" then return true elseif lt == "false" then return false end
				return original
			end
			if t == "Vector3" then
				local a, b, c = text:match("(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)")
				if a then return Vector3.new(tonumber(a), tonumber(b), tonumber(c)) end
				return original
			end
			if t == "table" then
				local out = {}
				if text:find("=") then
					for pair in text:gmatch("[^;]+") do
						local k, val = pair:match("^%s*(.-)%s*=%s*(.-)%s*$")
						if k then
							local inner = {}
							for piece in val:gmatch("[^|]+") do
								table.insert(inner, (piece:match("^%s*(.-)%s*$")))
							end
							out[k] = inner
						end
					end
					return out
				end
				for piece in text:gmatch("[^,]+") do
					local s = piece:match("^%s*(.-)%s*$")
					if s ~= "" then table.insert(out, s) end
				end
				return out
			end
			return text
		end

		local function setStat(tbl, key, value)
			local ok = pcall(rawset, tbl, key, value)
			if not ok then pcall(function() tbl[key] = value end) end
		end

