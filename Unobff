	return mp.X >= ap.X and mp.X <= ap.X + as.X and mp.Y >= ap.Y and mp.Y <= ap.Y + as.Y
end

local function checkGodFunctions()
	local missing = {}
	if type(hookmetamethod) ~= "function" then table.insert(missing, "hookmetamethod") end
	if type(getnamecallmethod) ~= "function" then table.insert(missing, "getnamecallmethod") end
	if type(hookfunction) ~= "function" then table.insert(missing, "hookfunction") end
	if type(checkcaller) ~= "function" then table.insert(missing, "checkcaller") end
	if type(newcclosure) ~= "function" then table.insert(missing, "newcclosure") end
	if #missing > 0 then
		showNotification("Critical Functions missing: " .. table.concat(missing, ", ") .. ". Option may not work.", 5)
	end
	return #missing == 0
end

local function installGodHooks()
	if god.HooksInstalled or not AttemptToolUse then return end
	god.HooksInstalled = true

	if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", wrapClosure(function(self, ...)
			if rawequal(self, AttemptToolUse) and getnamecallmethod() == "FireServer" then
				if godShouldBlock() then return end
			end
			return oldNamecall(self, ...)
		end))
	end

	if type(hookfunction) == "function" then
		local oldFire
		oldFire = hookfunction(AttemptToolUse.FireServer, function(self, ...)
			if rawequal(self, AttemptToolUse) then
				if godShouldBlock() then return end
			end
			return oldFire(self, ...)
		end)
	end
end

