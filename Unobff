local espFriendCache = {}
local function isFriend(plr)
	if plr == LocalPlayer then return true end
	local cached = espFriendCache[plr.UserId]
	if cached ~= nil then return cached end
	local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(plr.UserId) end)
	local v = ok and res or false
	espFriendCache[plr.UserId] = v
	return v
end

local function createBillboard(character, tag)
