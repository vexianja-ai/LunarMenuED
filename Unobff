	local function createColorPicker(parent, label, key)
		local holder = make("Frame", { Size = UDim2.new(1, 0, 0, 100), BackgroundColor3 = T.Panel,
			BackgroundTransparency = 0.35, BorderSizePixel = 0 }, parent)
		corner(holder, 9); stroke(holder, T.Stroke, 0.55)

		make("TextLabel", { Size = UDim2.new(1, -100, 0, 16), Position = UDim2.new(0, 10, 0, 6),
			BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, Text = label, TextColor3 = T.Text,
			TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left }, holder)
		local hex = make("TextLabel", { Size = UDim2.new(0, 60, 0, 16), Position = UDim2.new(1, -70, 0, 6),
			BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "#FFFFFF", TextColor3 = T.Dim,
			TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right }, holder)
		local swatch = make("Frame", { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -32, 0, 26),
			BackgroundColor3 = T[key], BorderSizePixel = 0 }, holder)
		corner(swatch, 6); stroke(swatch, Color3.new(1, 1, 1), 0.4)

		local h, s, v = T[key]:ToHSV()
		local bars = {}

		local function makeBar(y, gradFn, getV, setV)
			local track = make("TextButton", { Size = UDim2.new(1, -66, 0, 12), Position = UDim2.new(0, 10, 0, y),
				BackgroundColor3 = Color3.new(1, 1, 1), Text = "", AutoButtonColor = false }, holder)
			corner(track, 99); stroke(track, Color3.new(0, 0, 0), 0.6)
			local grad = make("UIGradient", { Color = gradFn() }, track)
			local knob = make("Frame", { Size = UDim2.new(0, 12, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(getV(), 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2 }, track)
			corner(knob, 99); stroke(knob, Color3.new(0, 0, 0), 0.3)
			local api = { grad = grad, knob = knob }
			bars[#bars + 1] = api

			local sliding, locked = false, nil
			local function fromX(px)
				setV(math.clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1))
			end
			track.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					sliding = true; locked = findScrollParent(track)
					if locked then locked.ScrollingEnabled = false end
					fromX(i.Position.X)
				end
			end)
			UserInputService.InputChanged:Connect(function(i)
				if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
					fromX(i.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					sliding = false
					if locked then locked.ScrollingEnabled = true; locked = nil end
				end
			end)
			return api
		end

		local function refresh()
			local col = Color3.fromHSV(h, s, v)
			T[key] = col
			swatch.BackgroundColor3 = col
			hex.Text = string.format("#%02X%02X%02X", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255))
			bars[1].grad.Color = ColorSequence.new(
				Color3.fromHSV(0, 1, 1), Color3.fromHSV(1/6, 1, 1), Color3.fromHSV(2/6, 1, 1),
				Color3.fromHSV(3/6, 1, 1), Color3.fromHSV(4/6, 1, 1), Color3.fromHSV(5/6, 1, 1), Color3.fromHSV(1, 1, 1))
			bars[2].grad.Color = ColorSequence.new(Color3.fromHSV(h, 0, v), Color3.fromHSV(h, 1, v))
			bars[3].grad.Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(h, s, 1))
			bars[1].knob.Position = UDim2.new(h, 0, 0.5, 0)
			bars[2].knob.Position = UDim2.new(s, 0, 0.5, 0)
			bars[3].knob.Position = UDim2.new(v, 0, 0.5, 0)
			applyThemeLive()
			saveConfig()
		end

		makeBar(32, function() return ColorSequence.new(Color3.new(1, 1, 1)) end, function() return h end,
			function(x) h = x; refresh() end)
		makeBar(56, function() return ColorSequence.new(Color3.new(1, 1, 1)) end, function() return s end,
			function(x) s = x; refresh() end)
		makeBar(80, function() return ColorSequence.new(Color3.new(1, 1, 1)) end, function() return v end,
			function(x) v = x; refresh() end)

		refresh()
		return holder
	end

