local function findStructureModel(parent, modelName)
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("Model") and child.Name:lower() == modelName:lower() then return child end
		local found = findStructureModel(child, modelName)
		if found then return found end
	end
	return nil
end

local function getStructureByName(modelName)
	if not modelName or modelName == "" then return nil end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then return nil end
	local roots = {}
	local structures = assets:FindFirstChild("Structures")
	if structures then
		local t = structures:FindFirstChild("Throwables")
		if t then table.insert(roots, t) end
		table.insert(roots, structures)
	end
	local itemModels = assets:FindFirstChild("ItemModels")
	if itemModels then table.insert(roots, itemModels) end
	for _, root in ipairs(roots) do
		local found = findStructureModel(root, modelName)
		if found then return found end
	end
	return nil
end

local function getThrowableModel(name)
	if not name or name == "" then return nil end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local items = assets and assets:FindFirstChild("Items")
	local im = items and items:FindFirstChild("ItemModels")
	local th = im and im:FindFirstChild("Throwables")
	return th and th:FindFirstChild(name)
end

local function ensurePrimaryPart(model)
	if not model or not model:IsA("Model") or model.PrimaryPart then return end
	local part = model:FindFirstChildWhichIsA("BasePart")
	if not part then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then part = d; break end
		end
	end
	if part then model.PrimaryPart = part end
end

local function applyThrowableStats(itemName)
	if type(ItemStats) ~= "table" then return end
	local stats = ItemStats[itemName]
	if not stats then
		ItemStats[itemName] = {
			CanThrow = true, Velocity = 350, DamagePerThrow = 45,
			Damage = 45, Range = 100, Cooldown = 0.1, Type = "Throwable"
		}
	else
		stats.CanThrow = true
		stats.Velocity = stats.Velocity or 350
		stats.DamagePerThrow = stats.DamagePerThrow or stats.Damage or 45
		stats.Range = stats.Range or 100
		stats.Cooldown = stats.Cooldown or 0.1
	end
end

local function setupAllItemsAsThrowables()
	local assetsFolder = ReplicatedStorage:FindFirstChild("Assets")
	local itemsFolder = assetsFolder and assetsFolder:FindFirstChild("Items")
	if not itemsFolder then return end

	local itemModelsFolder = itemsFolder:FindFirstChild("ItemModels") or Instance.new("Folder", itemsFolder)
	itemModelsFolder.Name = "ItemModels"
	local throwablesFolder = itemModelsFolder:FindFirstChild("Throwables")
	if not throwablesFolder then
		throwablesFolder = Instance.new("Folder", itemModelsFolder)
		throwablesFolder.Name = "Throwables"
	end

	local function processFolder(parentFolder)
		for _, item in ipairs(parentFolder:GetChildren()) do
			if item ~= throwablesFolder then
				if item:IsA("Model") then
					ensurePrimaryPart(item); applyThrowableStats(item.Name); item.Parent = throwablesFolder
				elseif item:IsA("Folder") then
					processFolder(item)
				end
			end
		end
	end
	processFolder(itemModelsFolder)

	for _, instance in ipairs(ReplicatedStorage:GetDescendants()) do
		if instance:IsA("Model") and instance.Parent ~= throwablesFolder then
			local parentName = instance.Parent and instance.Parent.Name:lower() or ""
			if not string.find(parentName, "structure") and not instance:FindFirstChildOfClass("Humanoid") then
				ensurePrimaryPart(instance); applyThrowableStats(instance.Name); instance.Parent = throwablesFolder
			end
		end
	end
end

pcall(setupAllItemsAsThrowables)

