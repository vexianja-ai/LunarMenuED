			BackgroundColor3 = Color3.fromRGB(150, 55, 55), Font = Enum.Font.GothamBold, Text = "Close",
			TextColor3 = T.Text, TextSize = 11, AutoButtonColor = false }, f)
		corner(close, 8); stroke(close, T.Stroke, 0.4)
		close.MouseButton1Click:Connect(function() playClick(); f:Destroy() end)
