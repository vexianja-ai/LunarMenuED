					make("TextLabel", { Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(48, 0),
						BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = e.name,
						TextColor3 = T.Text, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
