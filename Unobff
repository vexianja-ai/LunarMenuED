			Font = Enum.Font.Gotham, Text = "Draw with mouse or finger. Center = impact point.", TextColor3 = T.Dim,
			TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 61 }, panel)

		local canvas = make("Frame", { Size = UDim2.new(1, -32, 1, -104), Position = UDim2.new(0, 16, 0, 58),
			BackgroundColor3 = T.Field, ClipsDescendants = true, Active = true, ZIndex = 61 }, panel)
		corner(canvas, 8); stroke(canvas, T.Stroke, 0.4)

		local points = {}
		local drawing = false
		local function addPoint(px, py)
			local nx = math.clamp(((px - canvas.AbsolutePosition.X) / math.max(canvas.AbsoluteSize.X, 1) - 0.5) * 2, -1, 1)
			local ny = math.clamp(((py - canvas.AbsolutePosition.Y) / math.max(canvas.AbsoluteSize.Y, 1) - 0.5) * 2, -1, 1)
			table.insert(points, Vector2.new(nx, ny))
			local dot = make("Frame", { Size = UDim2.new(0, 6, 0, 6), AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new((nx + 1) / 2, 0, (ny + 1) / 2, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, canvas)
			corner(dot, 99)
		end
		canvas.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				drawing = true; addPoint(i.Position.X, i.Position.Y)
			end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if drawing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				addPoint(i.Position.X, i.Position.Y)
			end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drawing = false end
		end)

		local row = make("Frame", { Size = UDim2.new(1, -32, 0, 30), Position = UDim2.new(0, 16, 1, -40),
			BackgroundTransparency = 1, ZIndex = 61 }, panel)
		local function mk(text, x, col, fn)
			local b = make("TextButton", { Size = UDim2.new(0, 88, 1, 0), Position = UDim2.new(1, x, 0, 0),
				BackgroundColor3 = col, Font = Enum.Font.GothamBold, Text = text, TextColor3 = T.Text,
				TextSize = 11, AutoButtonColor = false, ZIndex = 62, ClipsDescendants = true }, row)
			corner(b, 8); local s = stroke(b, T.Stroke, 0.4); hover(b, col, T.Hover, s)
			b.MouseButton1Down:Connect(function() ripple(b) end)
			b.MouseButton1Click:Connect(function() playClick(); fn() end)
		end
		mk("Clear", -292, Color3.fromRGB(70, 50, 40), function()
			points = {}
			for _, c in ipairs(canvas:GetChildren()) do
				if c:IsA("Frame") and c.Size == UDim2.new(0, 6, 0, 6) then c:Destroy() end
			end
		end)
		mk("Exit", -196, Color3.fromRGB(90, 45, 55), function() panel:Destroy() end)
		mk("Done", -100, Color3.fromRGB(35, 110, 65), function()
			if #points == 0 then showNotification("Draw something first!", 1.5); return end
