UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		if input.UserInputType == Enum.UserInputType.MouseButton3 and concurrent.Active then
			local want = not concurrent.MultiLine
			concurrent.MultiLine = want
			concurrent.Path = {}
			if toggleRefs["Multi Line Mode"] then toggleRefs["Multi Line Mode"].set(want, true) end
			showNotification(want and "Multi Line ON" or "Multi Line OFF", 1.3)
		end
		return
	end

	if wellnessClickMode then
		local _, hit = getClickPosition()
		local ch = hit and hit:FindFirstAncestorOfClass("Model")
		local pl = ch and Players:GetPlayerFromCharacter(ch)
		if pl then
			wellnessTarget = pl; wellnessClickMode = false
			showNotification("Wellness target: " .. pl.Name, 1.5)
		end
		return
	end

	if throwEnabled and not concurrent.Active then
		local pos, hit = getClickPosition()
		throwAt(pos, hit)
	end
end)

task.spawn(function()
	while task.wait(protectExtras.Interval) do
		if protectModeActive and protectExtras.CustomItem ~= "" then
			local myChar = LocalPlayer.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if myRoot then
				for _, pl in ipairs(Players:GetPlayers()) do
					if pl ~= LocalPlayer and pl.Character then
						local tr = pl.Character:FindFirstChild("HumanoidRootPart")
						local th = pl.Character:FindFirstChildOfClass("Humanoid")
						if tr and th and th.Health > 0 and (tr.Position - myRoot.Position).Magnitude <= protectExtras.Radius then
							throwAt(tr.Position, tr, protectExtras.Count, protectExtras.CustomItem, protectExtras.Delay)
						end
					end
				end
			end
		end
	end
end)

