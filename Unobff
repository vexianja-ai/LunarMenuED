		local function doSearch(query)
			query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if query == "" then showNotification("Enter a PlaceId or game name", 1.6); return end
			clearResults()
			local asId = tonumber(query)

			if asId then
				local placeId = math.floor(asId)
				statusLine("Resolving PlaceId " .. placeId .. "...")
				task.spawn(function()
					local name = "Place " .. placeId
					pcall(function()
						local info = MarketplaceService:GetProductInfo(placeId, Enum.InfoType.Asset)
						if info and info.Name then name = info.Name end
					end)
					clearResults()
					addResultCard({ name = name, placeId = placeId })
					syncPanels()
				end)
				return
			end

			statusLine("Searching \"" .. query .. "\"...")
			task.spawn(function()
				local data = httpJson("https://games.roblox.com/v1/games/list?model.keyword=" ..
					HttpService:UrlEncode(query) .. "&model.maxRows=12")
				local games = data and data.games
				if not games or #games == 0 then
					clearResults(); statusLine("No results for \"" .. query .. "\""); syncPanels(); return
				end
				clearResults()
				local shown = 0
				for _, g in ipairs(games) do
					if shown >= 6 then break end
					local placeId = g.placeId or g.rootPlaceId
					if not placeId and g.id then
						local res = httpJson("https://games.roblox.com/v1/games?universeIds=" .. tostring(g.id))
						local entry = res and res.data and res.data[1]
						placeId = entry and entry.rootPlaceId
					end
					if placeId then
						shown += 1
						addResultCard({ name = g.name, placeId = placeId, players = g.playerCount })
					end
				end
				if shown == 0 then statusLine("No usable results") end
				syncPanels()
			end)
		end

