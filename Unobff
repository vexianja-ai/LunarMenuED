		local function trapEntries()
			local list = {
				{ text = "All Players", value = "all" },
				{ text = "Nearest Player", value = "nearest" },
				{ text = "Local Player", value = LocalPlayer },
			}
			for _, pl in ipairs(Players:GetPlayers()) do
				if pl ~= LocalPlayer then
					table.insert(list, { text = pl.DisplayName .. " (@" .. pl.Name .. ")", value = pl, image = getThumb(pl) })
				end
			end
			return list
		end

		local _, trapBody = createExpandPanel(p, "Trap Settings", 290, "Target, structure and amount")
		local trapDrop
		trapDrop = createDropdown(trapBody, "Trap Target", trapEntries(), function(e) trapCfg.Target = e.value end,
			{ tip = "Who to trap. Amount structures are ringed around them." })

		Players.PlayerAdded:Connect(function() task.wait(0.5); trapDrop.setEntries(trapEntries()) end)
		Players.PlayerRemoving:Connect(function() task.wait(0.3); trapDrop.setEntries(trapEntries()) end)

		createTextBox(trapBody, "Custom Structure", "defaults to builder structure", trapCfg.CustomStructure, function(v)
			trapCfg.CustomStructure = v; saveConfig()
		end, "Leave empty to use the builder structure")
		createSlider(trapBody, "Amount", 1, 20, trapCfg.Amount, 1, function(v) trapCfg.Amount = v; saveConfig() end, "Structures ringed around each target")

		local function resolveTrapTargets()
			local list = {}
			if trapCfg.Target == "all" then
				for _, pl in ipairs(Players:GetPlayers()) do
					if pl ~= LocalPlayer then table.insert(list, pl) end
				end
			elseif trapCfg.Target == "nearest" then
				local best, bd
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if root then
					for _, pl in ipairs(Players:GetPlayers()) do
						if pl ~= LocalPlayer and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
							local d = (pl.Character.HumanoidRootPart.Position - root.Position).Magnitude
							if not bd or d < bd then best, bd = pl, d end
						end
					end
				end
				if best then table.insert(list, best) end
			elseif typeof(trapCfg.Target) == "Instance" then
				table.insert(list, trapCfg.Target)
			end
			return list
		end

		local function placeTrap()
			local nm = (trapCfg.CustomStructure ~= "" and trapCfg.CustomStructure) or buildState.StructureName
			if not nm or nm == "" then showNotification("No structure selected!", 1.6); return end
			if not BuildPlaceRemote then return end
			local targets = resolveTrapTargets()
			if #targets == 0 then showNotification("No targets found", 1.5); return end
			local src = getStructureByName(nm)
			local size = 4
			if src then
				local ok, s = pcall(function() local _, b = src:GetBoundingBox(); return b end)
				if ok and s then size = math.max(s.X, s.Z) end
			end
			local radius = size * 0.75 + 4
			local amount = trapCfg.Amount
			showNotification("Trap: " .. amount .. "x " .. nm .. " on " .. #targets .. " target(s)", 2)
			task.spawn(function()
				for _, pl in ipairs(targets) do
					local root = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
					if root then
						local base = root.Position
						for i = 1, amount do
							local ang = ((i - 1) / amount) * math.pi * 2
							local pos = base + Vector3.new(math.cos(ang) * radius, 0, math.sin(ang) * radius)
							BuildPlaceRemote:FireServer(groundSnap(pos), nm, 0)
							task.wait(0.03)
						end
					end
				end
			end)
		end

