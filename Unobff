		if not uiRefs.minimized then return end
		if miniSquare and miniSquare.Parent then
			local absP = miniSquare.AbsolutePosition
			local s = miniSize()
			miniSquare.Size = UDim2.fromOffset(s, s)
			miniSquare.Position = UDim2.fromOffset(absP.X, absP.Y)
		end
	end

	local grip = make("TextButton", { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -22, 1, -22),
		BackgroundTransparency = 1, Text = "", ZIndex = 9 }, main)
	for i = 1, 3 do
		make("Frame", { Size = UDim2.new(0, 2 + i * 3, 0, 2), Position = UDim2.new(1, -(3 + i * 4), 1, -(3 + i * 4)),
			AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 9 }, grip)
	end
	local resizing, rStart, rStartSize
	grip.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			if uiRefs.minimized then return end
			resizing = true; rStart = i.Position; rStartSize = main.Size
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if resizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - rStart
			local newSize = UDim2.new(0, math.clamp(rStartSize.X.Offset + d.X, 420, 1400),
				0, math.clamp(rStartSize.Y.Offset + d.Y, 300, 900))
			main.Size = newSize
			glow.Size = newSize
			currentNormal = newSize
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)

	local dragging, dragStart, startPos, dragInput
	local function beginDrag(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInput = i
			dragStart = i.Position
			startPos = main.Position
			i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
		end
	end
	titleBar.InputBegan:Connect(beginDrag)

	UserInputService.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
			dragInput = i
			miniDragInput = i
		end
	end)
	RunService.RenderStepped:Connect(function()
		if dragging and dragInput and dragStart and startPos then
			local d = dragInput.Position - dragStart
			local np = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			main.Position = np; glow.Position = np
		end
		if miniDrag and miniDragInput and miniDragStart and miniStartPos and miniSquare and miniSquare.Parent then
			local d = miniDragInput.Position - miniDragStart
			miniSquare.Position = UDim2.new(miniStartPos.X.Scale, miniStartPos.X.Offset + d.X,
				miniStartPos.Y.Scale, miniStartPos.Y.Offset + d.Y)
		end
	end)

	local function toggleMinimize(force)
		local want = force ~= nil and force or not uiRefs.minimized
		if want == uiRefs.minimized then return end
		uiRefs.minimized = want

		if want then
			normalSize = main.Size
			normalPos = main.Position
			tooltip.Visible = false

			local absP, absS = main.AbsolutePosition, main.AbsoluteSize
			local cx, cy = absP.X + absS.X / 2, absP.Y + absS.Y / 2
			local s = miniSize()

			buildMiniGui(cx, cy)

			body.Visible = false
			titleBar.Visible = false
			grip.Visible = false
			for _, d in ipairs(resizeDecor) do d.Visible = false end

			local ti = TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local targetSize = UDim2.fromOffset(s, s)
			local targetPos = UDim2.fromOffset(cx - s / 2, cy - s / 2)
			local tw = TweenService:Create(main, ti, { Size = targetSize, Position = targetPos })
			TweenService:Create(glow, ti, { Size = targetSize, Position = targetPos }):Play()
			tw:Play()
			tw.Completed:Connect(function()
				main.Visible = false
				glow.Visible = false
				main.Size = normalSize
				main.Position = normalPos
				glow.Size = normalSize
				glow.Position = normalPos
			end)
		else
			if not (miniSquare and miniSquare.Parent) then
				main.Visible = true
				glow.Visible = true
				body.Visible = true
				titleBar.Visible = true
				grip.Visible = true
				for _, d in ipairs(resizeDecor) do d.Visible = true end
				main.Size = normalSize or currentNormal
				main.Position = normalPos or UDim2.new(0.5, -350, 0.5, -235)
				glow.Size = main.Size
				glow.Position = main.Position
				if miniGui then miniGui:Destroy(); miniGui = nil end
				return
			end

			local absP, absS = miniSquare.AbsolutePosition, miniSquare.AbsoluteSize
			local cx, cy = absP.X + absS.X / 2, absP.Y + absS.Y / 2
			local s = absS.X

			main.Visible = true
			glow.Visible = true
			body.Visible = true
			titleBar.Visible = true
			grip.Visible = true
			for _, d in ipairs(resizeDecor) do d.Visible = true end

			local fromSize = UDim2.fromOffset(s, s)
			local fromPos = UDim2.fromOffset(cx - s / 2, cy - s / 2)
			main.Size = fromSize
			main.Position = fromPos
			glow.Size = fromSize
			glow.Position = fromPos

			local ti = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			TweenService:Create(main, ti, { Size = normalSize, Position = normalPos }):Play()
			TweenService:Create(glow, ti, { Size = normalSize, Position = normalPos }):Play()

			if miniGui then miniGui:Destroy(); miniGui = nil end
			miniSquare = nil
			miniDrag = false
		end
	end

	buildMiniGui = function(cx, cy)
		if miniGui then miniGui:Destroy() end
		miniGui = make("ScreenGui", { Name = "LunarMini", ResetOnSpawn = false,
			IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 60 }, UI_PARENT)

		local s = miniSize()
		miniSquare = make("Frame", { Size = UDim2.fromOffset(s, s),
			Position = UDim2.fromOffset(cx - s / 2, cy - s / 2),
			BackgroundColor3 = T.Bg2, BorderSizePixel = 0, Active = true, ZIndex = 1 }, miniGui)
		corner(miniSquare, 12)
		stroke(miniSquare, T.Accent, 0.2, 1.6)
		themeGradient(miniSquare, "Bg1", "Bg2", 135)
		make("ImageLabel", { Size = UDim2.new(1, -12, 1, -12), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1, Image = LOGO_ID }, miniSquare)
		for _, pos in ipairs({ UDim2.new(0, 5, 1, -19), UDim2.new(1, -19, 1, -19) }) do
			local b = make("Frame", { Size = UDim2.new(0, 14, 0, 14), Position = pos, BackgroundTransparency = 1 }, miniSquare)
			stroke(b, T.Accent, 0.35, 2)
		end

		miniSquare.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				miniDrag = true
				miniDragInput = i
				miniDragStart = i.Position
				miniStartPos = miniSquare.Position
				miniPressAt = i.Position
				i.Changed:Connect(function()
					if i.UserInputState == Enum.UserInputState.End then miniDrag = false end
				end)
			end
		end)
		miniSquare.InputEnded:Connect(function(i)
			if miniPressAt and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				local moved = (i.Position - miniPressAt).Magnitude
				miniPressAt = nil
				if moved < 6 then playClick(); toggleMinimize(false) end
			end
		end)
	end

	minBtn.MouseButton1Click:Connect(function() playClick(); toggleMinimize() end)

	keybinds["Minimize Menu"] = keybinds["Minimize Menu"] or Enum.KeyCode.M
	keyTriggers["Minimize Menu"] = function() toggleMinimize() end
	uiRefs.toggleMinimize = toggleMinimize

	local function toggleVisible()
		gui.Enabled = not gui.Enabled
		if miniGui then miniGui.Enabled = gui.Enabled end
	end
	keybinds["Toggle UI"] = keybinds["Toggle UI"] or Enum.KeyCode.Escape
	keyTriggers["Toggle UI"] = toggleVisible
	uiRefs.toggleVisible = toggleVisible

	-- CLOSE
	closeBtnReal.MouseButton1Click:Connect(function()
		playClick()
		for _, api in pairs(toggleRefs) do pcall(function() api.set(false) end) end
		pcall(function() if uiRefs.cancelBuild then uiRefs.cancelBuild() end end)
		pcall(stopSpreadAttack)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then removeESP(plr.Character, "PlayerESP") end
		end
		forEachAnimal(function(a) removeESP(a, "AnimalESP") end)
		for m in pairs(structEspMarked) do if m and m.Parent then structEspRemove(m) end end
		structEspMarked = {}
		for _, n in ipairs({ "LunarConstructSandbox", "LunarConstructHandles" }) do
			local f = Workspace:FindFirstChild(n); if f then f:Destroy() end
		end
		local bg = UI_PARENT:FindFirstChild("LunarBuildUI"); if bg then bg:Destroy() end
		Lighting.GlobalShadows = true
		LocalPlayer.CameraMode = Enum.CameraMode.Classic
		LocalPlayer.CameraMaxZoomDistance = 128
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 12 end
		pcall(function() saveConfig(true) end)
		showNotification("Menu closed — everything disabled", 1.8)
		if miniGui then miniGui:Destroy(); miniGui = nil end
		gui:Destroy()
		if type(CLOSE_SCRIPT) == "string" and CLOSE_SCRIPT ~= "" then
			task.spawn(function()
				if type(loadstring) ~= "function" then warn("[Lunar] loadstring not available"); return end
				local compiled, fn = pcall(loadstring, CLOSE_SCRIPT)
				if not compiled or type(fn) ~= "function" then warn("[Lunar] CLOSE_SCRIPT failed to compile"); return end
				local ok, err = pcall(fn)
				if not ok then warn("[Lunar] CLOSE_SCRIPT error: " .. tostring(err)) end
			end)
		end
	end)

	------------------------------------------------
	-- AMBIENT
	------------------------------------------------
	task.spawn(function()
		while gui.Parent do
			task.wait(5)
			sheen.Position = UDim2.new(0, -220, -0.3, 0)
			TweenService:Create(sheen, TweenInfo.new(1.6, Enum.EasingStyle.Linear), { Position = UDim2.new(1, 40, -0.3, 0) }):Play()
		end
	end)
	task.spawn(function()
		while gui.Parent do
			scan.Position = UDim2.new(0, 10, 0, 46)
			TweenService:Create(scan, TweenInfo.new(2.4, Enum.EasingStyle.Linear), { Position = UDim2.new(0, 10, 1, -4) }):Play()
			task.wait(2.8)
		end
	end)
	task.spawn(function()
		while gui.Parent do
			TweenService:Create(mainStroke, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Transparency = 0.55 }):Play()
			TweenService:Create(glow, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.88 }):Play()
			task.wait(1.8)
			TweenService:Create(mainStroke, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Transparency = 0.25 }):Play()
			TweenService:Create(glow, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.78 }):Play()
			task.wait(1.8)
		end
	end)
end

----------------------------------------------------
-- GLOBAL KEYBIND LISTENER
----------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end

	if listeningAction then
		local act = listeningAction
		if input.KeyCode == Enum.KeyCode.Backspace then
			keybinds[act] = Enum.KeyCode.Unknown
			showNotification("Cleared keybind: " .. act, 1.5)
		elseif input.KeyCode ~= Enum.KeyCode.Unknown then
			keybinds[act] = input.KeyCode
			showNotification("Bound [" .. input.KeyCode.Name .. "] -> " .. act, 1.6)
		end
		listeningAction = nil
		refreshKeyVisual(act)
		saveConfig()
		return
	end

	if UserInputService:GetFocusedTextBox() then return end

	if uiRefs.gui and uiRefs.gui.Parent and not uiRefs.minimized and uiRefs.goToPage then
		local names = { "General", "Item", "Builder", "Miscellaneous", "Settings" }
		local idx = table.find(names, currentPageName) or 1
		if input.KeyCode == Enum.KeyCode.Up then
			uiRefs.goToPage(names[math.max(idx - 1, 1)]); return
		elseif input.KeyCode == Enum.KeyCode.Down then
			uiRefs.goToPage(names[math.min(idx + 1, #names)]); return
		end
	end

	if uiRefs.freecamActive and uiRefs.freecamActive() then return end
	if not keybindsEnabled then return end
	for act, key in pairs(keybinds) do
		if key and key ~= Enum.KeyCode.Unknown and input.KeyCode == key and keyTriggers[act] then
			keyTriggers[act]()
		end
	end
end)

