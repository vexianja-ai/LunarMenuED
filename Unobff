		local function cancelConstruct()
			if not buildState.IsConstructing then return end
			pendingDrag = nil
			freecamStop()
			clearLine()
			clearSelection()
			for _, m in ipairs(allModels()) do m:Destroy() end
			undoStack, redoStack = {}, {}
			tool = nil
			highlightTool(nil)
			buildState.IsConstructing = false
			hotbar.Visible = false
			keyHud.Visible = false
			refreshConstructButton()
		end
		uiRefs.cancelBuild = cancelConstruct

		local function startConstruct()
			if buildState.IsConstructing then return end
			local name = buildState.StructureName
			if not name or name == "" then showNotification("Enter or pick a structure first", 1.8); return end
			if not getStructureByName(name) then showNotification("Structure not found: " .. name, 2); return end
			buildState.IsConstructing = true
			hotbar.Visible = true
			keyHud.Visible = not IS_MOBILE
			refreshConstructButton()
			if not spawnInFront(name) then
				buildState.IsConstructing = false
				hotbar.Visible = false
				keyHud.Visible = false
				refreshConstructButton()
				return
			end
			showNotification("Constructing: " .. name, 1.4)
		end

		local function addAnother()
			local name = buildState.StructureName
			if name == "" then return end
			pushHistory()
			spawnInFront(name)
		end

		local function commitBuild()
			local models = allModels()
			if #models == 0 then showNotification("Nothing to build", 1.5); return end
			if not BuildPlaceRemote then showNotification("BuildPlace remote missing", 2); return end
			local placed = 0
			for _, m in ipairs(models) do
				local id = m:GetAttribute("StructureName") or buildState.StructureName
				local cf = m:GetPivot()
				local _, ry = cf:ToEulerAnglesYXZ()
				BuildPlaceRemote:FireServer(cf.Position, id, math.deg(ry))
				placed += 1
			end
			showNotification("Built " .. placed .. " structure(s)", 1.6)
			cancelConstruct()
		end

