local function buildShapeOffsets(count)
	if count <= 1 then return { Vector2.new(0, 0) } end
	local pts = {}
	if throwShape == "Box" then
		local side = math.ceil(math.sqrt(count))
		for i = 0, count - 1 do
			table.insert(pts, Vector2.new((i % side) - (side - 1) / 2, math.floor(i / side) - (side - 1) / 2))
		end
	elseif throwShape == "Custom" and #throwCustom > 0 then
		for i = 1, count do table.insert(pts, throwCustom[((i - 1) % #throwCustom) + 1]) end
	else
		for i = 1, count do
			local a = (i / count) * math.pi * 2
			table.insert(pts, Vector2.new(math.cos(a), math.sin(a)))
		end
	end
	return pts
end

local function throwAt(targetPos, hitInstance, countOverride, itemOverride, delayOverride)
	local ch = LocalPlayer.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
	local count = countOverride or throwCount
	local offsets = buildShapeOffsets(count)
	local c = getCamera()
	local item = itemOverride or currentThrowableName
	local d = delayOverride or throwDelay
	task.spawn(function()
		for _, o in ipairs(offsets) do
			local spawnPos = hrp.Position + Vector3.new(0, 5, 0)
				+ c.CFrame.RightVector * (o.X * THROW_SPREAD)
				+ c.CFrame.UpVector * (o.Y * THROW_SPREAD)
			Framework.create_spear(item, ch, spawnPos, targetPos, false)
			task.wait(d)
		end
		task.wait(0.25)
		if hitInstance then triggerMultiImpactFX(hitInstance, targetPos) end
	end)
end

