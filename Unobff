			PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, list)

		local function fill(filter)
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("TextButton") then c:Destroy() end
			end
