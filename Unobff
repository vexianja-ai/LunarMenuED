	if god.MobileBtn == btn and god.MobileConn then return true end
	if god.MobileConn then pcall(function() god.MobileConn:Disconnect() end) end
	god.MobileBtn = btn
	god.MobileConn = btn.Activated:Connect(function()
		godFire()
	end)
	return true
