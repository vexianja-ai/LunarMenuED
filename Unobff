	end

	-- combined toggle + keybind:  [Label .......... [K]  (o) ]
	local function createToggleKeybind(parent, label, initial, onChange, defaultKey, tip, register)
		local row = make("TextButton", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Panel, Text = "",
			AutoButtonColor = false, ClipsDescendants = true }, parent)
		corner(row, 9); local s = stroke(row, T.Stroke, 0.45); hover(row, T.Panel, T.Hover, s)

		make("TextLabel", { Size = UDim2.new(1, -120, 1, 0), Position = UDim2.new(0, 12, 0, 0),
			BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, Text = label, TextColor3 = T.Text,
			TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)

		local track = make("Frame", { Size = UDim2.new(0, 38, 0, 18), Position = UDim2.new(1, -50, 0.5, -9),
			BackgroundColor3 = Color3.fromRGB(40, 46, 70), BorderSizePixel = 0 }, row)
		corner(track, 99); local ts = stroke(track, T.Stroke, 0.5)
		local knob = make("Frame", { Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 2, 0.5, -7),
			BackgroundColor3 = Color3.fromRGB(200, 210, 235), BorderSizePixel = 0 }, track)
		corner(knob, 99)

		local keyText
		if not IS_MOBILE then
			keyText = make("TextLabel", { Size = UDim2.new(0, 48, 0, 20), Position = UDim2.new(1, -102, 0.5, -10),
				BackgroundColor3 = Color3.fromRGB(26, 32, 58), Font = Enum.Font.GothamBold,
				Text = "[..]", TextColor3 = T.Accent, TextSize = 10, ZIndex = 3 }, row)
			corner(keyText, 6); stroke(keyText, T.Stroke, 0.55)
			local key = keybinds[label] or defaultKey
			keybinds[label] = key
			keyText.Text = "[" .. key.Name .. "]"
			keyRefs[label] = keyText
		end

		local state = initial
		local function refresh(animate)
			local ti = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			local target = { BackgroundColor3 = state and Color3.fromRGB(38, 120, 70) or Color3.fromRGB(40, 46, 70) }
			local kp = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
			local kc = state and T.Good or Color3.fromRGB(200, 210, 235)
			if animate then
				TweenService:Create(track, ti, target):Play()
				TweenService:Create(knob, ti, { Position = kp, BackgroundColor3 = kc }):Play()
				TweenService:Create(ts, ti, { Color = state and T.Good or T.Stroke, Transparency = state and 0.2 or 0.5 }):Play()
			else
				track.BackgroundColor3 = target.BackgroundColor3
				knob.Position = kp; knob.BackgroundColor3 = kc
			end
		end

		local api = {}
		function api.toggle()
			state = not state; refresh(true); playClick()
			if onChange then onChange(state) end
			saveConfig()
		end
		function api.get() return state end
		function api.set(v, silent)
			if state == v then return end
			state = v; refresh(true)
			if onChange and not silent then onChange(state) end
		end

		row.MouseButton1Down:Connect(function() ripple(row) end)
		row.MouseButton1Click:Connect(function()
			local mp = UserInputService:GetMouseLocation()
			local localX = mp.X - row.AbsolutePosition.X
			if keyText and localX >= row.AbsoluteSize.X - 106 and localX < row.AbsoluteSize.X - 56 then
				listeningAction = label
				keyText.Text = "[...]"; keyText.TextColor3 = T.Warn
				showNotification("Press a key to bind: " .. label, 1.5)
				playClick()
			else
				api.toggle()
			end
		end)
		row.MouseButton2Click:Connect(function()
			if not keyText then return end
			listeningAction = label
			keyText.Text = "[...]"; keyText.TextColor3 = T.Warn
			playClick()
		end)

		if tip then addTooltip(row, tip) end
		if keyText then keyTriggers[label] = api.toggle else keyTriggers[label] = api.toggle end
		refresh(false)
		if register ~= false then toggleRefs[label] = api end
		return api
	end

	local function createToggle(parent, label, initial, onChange, tip, register)
		return createToggleKeybind(parent, label, initial, onChange, Enum.KeyCode.Unknown, tip, register)
	end

