		while sg.Parent do
			tween(logoGlow, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ BackgroundTransparency = 0.92, Size = UDim2.fromOffset(72, 72) })
			task.wait(1.6)
			tween(logoGlow, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ BackgroundTransparency = 0.8, Size = UDim2.fromOffset(62, 62) })
			task.wait(1.6)
		end
	end)
	task.spawn(function()
		while sg.Parent do
			shimmer.Position = UDim2.new(0, -50, 0, 0)
			tween(shimmer, TweenInfo.new(1.5, Enum.EasingStyle.Linear), { Position = UDim2.new(1, 10, 0, 0) })
			task.wait(2.0)
		end
	end)

	local stages = {
		{ 0.00, "Fetching Modules..." }, { 0.15, "Resolving Remotes..." }, { 0.30, "Applying Hooks..." },
		{ 0.48, "Loading Item Stats..." }, { 0.63, "Indexing Throwables..." },
		{ 0.78, "Building Interface..." }, { 0.90, "Loading UI..." }, { 0.97, "Ready" },
	}
	local lastStage = 0

	task.spawn(function()
		local ok, err = pcall(function()
			local t0 = tick()
			while not done do
				local a = math.clamp((tick() - t0) / duration, 0, 1)
				local eased = 1 - (1 - a) * (1 - a)
				barFill.Size = UDim2.new(eased, 0, 1, 0)
				percent.Text = string.format("%d%%", math.floor(eased * 100))
				for i = #stages, 1, -1 do
					if a >= stages[i][1] then
						if i ~= lastStage then
							lastStage = i
							status.Text = stages[i][2]
							status.TextTransparency = 1
							tween(status, TweenInfo.new(0.25), { TextTransparency = 0 })
						end
						break
					end
				end
				if a >= 1 then break end
				RunService.RenderStepped:Wait()
			end
			status.Text = "Ready"
			tween(status, TweenInfo.new(0.3), { TextTransparency = 0 })
			task.wait(0.45)
			for _, e in ipairs(fadeList) do tween(e[1], TweenInfo.new(0.45), { [e[2]] = 1 }) end
			for _, r in ipairs(rings) do
				tween(r.ring, TweenInfo.new(0.45), { BackgroundTransparency = 1 })
				tween(r.stroke, TweenInfo.new(0.45), { Transparency = 1 })
			end
			tween(cardStroke, TweenInfo.new(0.45), { Transparency = 1 })
			tween(cardGlow, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
			tween(card, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.new(0.5, 0, 0.5, -14), BackgroundTransparency = 1
			})
			task.wait(0.6)
		end)
		if not ok then warn("[Lunar] loading screen error: " .. tostring(err)) end
		finish()
	end)
end

