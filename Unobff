	do
		local p = PAGE.Miscellaneous
		sectionTitle(p, "Line Builder")

		local function lineStructureName()
			return (lineCfg.CustomStructure ~= "" and lineCfg.CustomStructure) or buildState.StructureName
		end
		local function dominantDir()
			local look = getCamera().CFrame.LookVector
			if math.abs(look.Y) > 0.75 then return Vector3.new(0, math.sign(look.Y), 0) end
			if math.abs(look.X) >= math.abs(look.Z) then return Vector3.new(math.sign(look.X), 0, 0) end
			return Vector3.new(0, 0, math.sign(look.Z))
		end

		local function buildLine()
			local ch = LocalPlayer.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
			local dir = dominantDir()
			local spacing = math.max(lineCfg.PerStuds, 0.5)
			local count = math.min(math.floor(lineCfg.Range / spacing), 1200)
			local origin = hrp.Position
			local nm = lineStructureName()
			if not nm or nm == "" then showNotification("No structure selected!", 1.6); return end
			showNotification("Line build: " .. count .. "x " .. nm, 2)
			task.spawn(function()
				local batch = 0
				for i = 1, count do
					local pos = origin + dir * (spacing * i)
					if lineCfg.GroundSnap then pos = groundSnap(pos) end
					if BuildPlaceRemote then BuildPlaceRemote:FireServer(pos, nm, buildState.Rotation.Y) end
					batch += 1
					if batch >= 10 then batch = 0; RunService.Heartbeat:Wait() end
				end
			end)
		end

		createToggleKeybind(p, "Build Line", false, function(v) if v then buildLine() end end, Enum.KeyCode.H, "Builds in front of your look direction")

		local _, lineBody = createExpandPanel(p, "Line Settings", "Range, spacing and preview")
		local pv = make("ViewportFrame", { Size = UDim2.new(1, 0, 0, 86), BackgroundColor3 = T.Field }, lineBody)
		corner(pv, 8); stroke(pv, T.Stroke, 0.5)
		local pvCam = newViewportCamera(pv); pv.CurrentCamera = pvCam
		local pvWorld = make("WorldModel", {}, pv)
		local pvLabel = make("TextLabel", { Size = UDim2.new(1, -10, 0, 14), Position = UDim2.new(0, 6, 0, 2),
			BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "SPACING PREVIEW", TextColor3 = T.Dim,
			TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 }, pv)

		local function refreshSpacingPreview()
			pvWorld:ClearAllChildren()
			local src = getStructureByName(lineStructureName())
			if not src then pvCam.CFrame = CFrame.new(Vector3.new(10, 10, 10), Vector3.zero); return end
			local a = src:Clone(); a.Parent = pvWorld
			local bm = src:Clone(); bm.Parent = pvWorld
			local _, sz = src:GetBoundingBox()
			local gap = math.max(lineCfg.PerStuds, 0.5)
			if a:IsA("Model") then a:PivotTo(CFrame.new(0, 0, 0)) else a.CFrame = CFrame.new(0, 0, 0) end
			if bm:IsA("Model") then bm:PivotTo(CFrame.new(0, 0, -gap)) else bm.CFrame = CFrame.new(0, 0, -gap) end
			local camDist = sz.Magnitude * 1.5 + 4
			local mid = Vector3.new(0, 0, -gap / 2)
			pvCam.CFrame = CFrame.new(mid + Vector3.new(1, 0.7, 1).Unit * camDist, mid)
			pvLabel.Text = "SPACING PREVIEW - " .. gap .. " studs"
		end

		createSlider(lineBody, "Maximum Range", 100, 8000, lineCfg.Range, 50, function(v) lineCfg.Range = v end, "Max line length in studs")
		createTextBox(lineBody, "Structure Per Studs", "e.g. 8", tostring(lineCfg.PerStuds), function(v)
			local n = tonumber(v); if n and n > 0 then lineCfg.PerStuds = n; refreshSpacingPreview() end
		end, "One structure placed every N studs")
		createTextBox(lineBody, "Custom Structure", "defaults to builder structure", lineCfg.CustomStructure, function(v)
			lineCfg.CustomStructure = v; refreshSpacingPreview()
		end, "Leave empty to use the builder structure")
		createToggle(lineBody, "Ground Snap", lineCfg.GroundSnap, function(v) lineCfg.GroundSnap = v end, "Drop each structure onto the ground", false)
		refreshSpacingPreview()

		sectionTitle(p, "Trap")
		createToggleKeybind(p, "Place Trap", false, function(v)
			if not v then return end
			local nm = (trapCfg.CustomStructure ~= "" and trapCfg.CustomStructure) or buildState.StructureName
			if not nm or nm == "" then showNotification("No structure selected!", 1.6); return end
			if not BuildPlaceRemote then return end
			local targets = resolveTargets(trapCfg.Targets)
			if #targets == 0 then showNotification("No targets found", 1.5); return end
			local src = getStructureByName(nm)
			local size = 4
			if src then
				local ok, s = pcall(function() local _, b = src:GetBoundingBox(); return b end)
				if ok and s then size = math.max(s.X, s.Z) end
			end
			local radius = size * 0.75 + 4
			local amount = trapCfg.Amount
			showNotification("Trap: " .. amount .. "x " .. nm .. " on " .. #targets .. " target(s)", 2)
			task.spawn(function()
				for _, pl in ipairs(targets) do
					local root = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
					if root then
						local base = root.Position
						for i = 1, amount do
							local ang = ((i - 1) / amount) * math.pi * 2
							local pos = base + Vector3.new(math.cos(ang) * radius, 0, math.sin(ang) * radius)
							BuildPlaceRemote:FireServer(groundSnap(pos), nm, 0)
							task.wait(0.03)
						end
					end
				end
			end)
		end, Enum.KeyCode.Y, "Ring structures around the selected target(s)")

