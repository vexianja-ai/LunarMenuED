		local function makeDraggableButton(btn)
			local held, startPos, pressAt, moved
			btn.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					held = true; moved = false; pressAt = i.Position; startPos = btn.Position
					if btn == zoomIn then freecam.zoomInHeld = true end
					if btn == zoomOut then freecam.zoomOutHeld = true end
				end
			end)
			btn.InputChanged:Connect(function(i)
				if not held then return end
				if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement then
					local d = i.Position - pressAt
					if d.Magnitude > 4 then moved = true end
					if moved then
						btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
							startPos.Y.Scale, startPos.Y.Offset + d.Y)
					end
				end
			end)
			btn.InputEnded:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					held = false
					if btn == zoomIn then freecam.zoomInHeld = false end
					if btn == zoomOut then freecam.zoomOutHeld = false end
				end
			end)
		end
