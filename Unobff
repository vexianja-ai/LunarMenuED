		local function lineStructureName()
			return (lineCfg.CustomStructure ~= "" and lineCfg.CustomStructure) or buildState.StructureName
		end
		local function dominantDir()
			local look = getCamera().CFrame.LookVector
			if math.abs(look.Y) > 0.75 then return Vector3.new(0, math.sign(look.Y), 0) end
			if math.abs(look.X) >= math.abs(look.Z) then return Vector3.new(math.sign(look.X), 0, 0) end
			return Vector3.new(0, 0, math.sign(look.Z))
		end

		local function buildLine()
			local ch = LocalPlayer.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
			local dir = dominantDir()
			local spacing = math.max(lineCfg.PerStuds, 0.5)
			local count = math.min(math.floor(lineCfg.Range / spacing), 1200)
			local origin = hrp.Position
			local nm = lineStructureName()
			if not nm or nm == "" then showNotification("No structure selected!", 1.6); return end
			showNotification("Line build: " .. count .. "x " .. nm, 2)
			task.spawn(function()
				local batch = 0
				for i = 1, count do
					local pos = origin + dir * (spacing * i)
					if lineCfg.GroundSnap then pos = groundSnap(pos) end
					if BuildPlaceRemote then BuildPlaceRemote:FireServer(pos, nm, buildState.Rotation.Y) end
					batch += 1
					if batch >= 10 then batch = 0; RunService.Heartbeat:Wait() end
				end
			end)
		end

