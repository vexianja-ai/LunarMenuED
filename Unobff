		local constructBtn, buildBtn, cancelBtn

		local function refreshConstructButton()
			if not constructBtn then return end
			constructBtn.Text = buildState.IsConstructing and "Add" or "Construct"
			constructBtn.BackgroundColor3 = buildState.IsConstructing
				and Color3.fromRGB(140, 95, 40) or Color3.fromRGB(38, 166, 91)
