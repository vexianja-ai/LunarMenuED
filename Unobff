local hookmetamethod, getnamecallmethod, newcclosure, checkcaller, getconnections, hookfunction =
	hookmetamethod, getnamecallmethod, newcclosure, checkcaller, getconnections, hookfunction

local wrapClosure = newcclosure or function(f) return f end

local HOOK_DEPS = { "hookmetamethod", "getnamecallmethod", "newcclosure", "checkcaller", "getconnections" }
local hookWarned = false
local function ensureHookSupport()
	if hookWarned then return end
	local map = { hookmetamethod = hookmetamethod, getnamecallmethod = getnamecallmethod,
		newcclosure = newcclosure, checkcaller = checkcaller, getconnections = getconnections }
	local miss = {}
	for _, n in ipairs(HOOK_DEPS) do if type(map[n]) ~= "function" then table.insert(miss, n) end end
	if #miss > 0 then
		hookWarned = true
		showNotification("Unsupported: " .. table.concat(miss, ", "), 4)
	end
end

