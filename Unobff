local function spreadFreeze(on)
	local ch = LocalPlayer.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if on then
		spreadAttack.Walk = hum.WalkSpeed; spreadAttack.Jump = hum.JumpPower; spreadAttack.JumpH = hum.JumpHeight
		hum.WalkSpeed = 0; hum.JumpPower = 0; hum.JumpHeight = 0
	else
		hum.WalkSpeed = spreadAttack.Walk or 12
		hum.JumpPower = spreadAttack.Jump or 50
		hum.JumpHeight = spreadAttack.JumpH or 7.2
	end
end

local function spreadRandomPoint(origin)
	local ang = math.random() * math.pi * 2
	local rad = math.sqrt(math.random()) * spreadCfg.Range
	return origin + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
end

local function spreadPickTarget(origin)
	local weighted, total = {}, 0
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LocalPlayer and pl.Character then
			local tr = pl.Character:FindFirstChild("HumanoidRootPart")
			local hum = pl.Character:FindFirstChildOfClass("Humanoid")
			if tr and hum and hum.Health > 0 then
				local d = (tr.Position - origin).Magnitude
				if d <= spreadCfg.Range then
					local w = 1 / math.max(d, 2)
					total += w
					table.insert(weighted, { pos = tr.Position, part = tr, hum = hum, w = w })
				end
			end
		end
	end
	if #weighted > 0 and spreadCfg.TargetPlayers and math.random() < 0.8 then
		local r = math.random() * total
		local acc = 0
		local pick = weighted[#weighted]
		for _, c in ipairs(weighted) do
			acc += c.w
			if r <= acc then pick = c; break end
		end
		local jitter = Vector3.new((math.random() - 0.5) * 3, (math.random() - 0.5) * 2, (math.random() - 0.5) * 3)
		return pick.pos + jitter, pick.part, pick.hum
	end
	return groundSnap(spreadRandomPoint(origin)), nil, nil
end

local function spreadThrowOnce()
	local ch = LocalPlayer.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root or not root.Parent then return end
	local item = (spreadCfg.CustomItem ~= "" and spreadCfg.CustomItem) or currentThrowableName
	local origin = root.Position
	local targetPos, hitPart, hum = spreadPickTarget(origin)
	local spawnPos = origin + Vector3.new(0, 5, 0)
		+ Vector3.new((math.random() - 0.5) * 4, (math.random() - 0.5) * 2, (math.random() - 0.5) * 4)
	Framework.create_spear(item, ch, spawnPos, targetPos, false)
	if hitPart and hum and SpearReplicationHit then
		task.spawn(function()
			if hum.Parent and hitPart.Parent then
				Framework.FX_Blood(hitPart, 2)
				SpearReplicationHit:FireServer({
					position = targetPos, cframe = CFrame.new(targetPos),
					hitPart = hitPart, startPosition = spawnPos
				}, item, hum)
			end
		end)
	end
end

local function startSpreadAttack()
	if spreadAttack.Active then return end
	local ch = LocalPlayer.Character
	if not ch or not ch:FindFirstChild("HumanoidRootPart") then
		showNotification("No character!", 1.4); return
	end
	spreadAttack.Active = true
	spreadFreeze(true)
	if spreadToggleRef then spreadToggleRef.set(true, true) end
	showNotification("SPREAD ATTACK — " .. spreadCfg.Duration .. "s", 1.6)
	task.spawn(function()
		local finish = tick() + math.max(spreadCfg.Duration, 0.2)
		while spreadAttack.Active and tick() < finish do
			if not LocalPlayer.Character then break end
			spreadThrowOnce()
			task.wait(0.03)
		end
		spreadAttack.Active = false
		spreadFreeze(false)
		if spreadToggleRef then spreadToggleRef.set(false, true) end
	end)
end

local function stopSpreadAttack()
	if not spreadAttack.Active then return end
	spreadAttack.Active = false
	spreadFreeze(false)
	if spreadToggleRef then spreadToggleRef.set(false, true) end
end

