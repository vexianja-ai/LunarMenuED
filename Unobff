	local function createDropdown(parent, title, entries, onSelect, opts)
		opts = opts or {}
		local container = make("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, ClipsDescendants = true }, parent)
		local header = make("TextButton", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = T.Panel, Text = "",
			AutoButtonColor = false, ClipsDescendants = true }, container)
		corner(header, 9); local hs = stroke(header, T.Stroke, 0.45); hover(header, T.Panel, T.Hover, hs)
		local tl = make("TextLabel", { Size = UDim2.new(1, -110, 1, 0), Position = UDim2.new(0, 14, 0, 0),
			BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, Text = title, TextColor3 = T.Text,
			TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, header)
		if opts.tip then addTooltip(tl, opts.tip) end
		local valueLbl = make("TextLabel", { Size = UDim2.new(0, 104, 1, 0), Position = UDim2.new(1, -146, 0, 0),
			BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = "", TextColor3 = T.Accent,
			TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd }, header)
		local arrow = make("TextLabel", { Size = UDim2.new(0, 30, 1, 0), Position = UDim2.new(1, -38, 0, 0),
			BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "v", TextColor3 = T.Accent, TextSize = 13 }, header)

		local listH = math.min(#entries * 30 + 12, 180)
		local extraH = opts.extraHeight or 0
		local contentBox = make("Frame", { Size = UDim2.new(1, 0, 0, listH + extraH + 16), Position = UDim2.new(0, 0, 0, 42),
			BackgroundColor3 = T.Bg2, BackgroundTransparency = 0.05, Visible = false }, container)
		corner(contentBox, 9); stroke(contentBox, T.Accent, 0.45)

		local list = make("ScrollingFrame", { Size = UDim2.new(1, -16, 0, listH), Position = UDim2.new(0, 8, 0, 8),
			BackgroundTransparency = 1, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent }, contentBox)
		make("UIListLayout", { Padding = UDim.new(0, 4) }, list)

		local current, isOpen = nil, false
		local selected = {}
		local rowLabels, rowBase = {}, {}

		local function updateCount()
			local n = 0
			for _ in pairs(selected) do n += 1 end
			valueLbl.Text = n > 0 and (n .. " selected") or "none"
		end

		local api = {}
		function api.setValue(v, text) current = v; valueLbl.Text = text or tostring(v) end
		function api.get() return current end
		function api.getSelected() return selected end
		function api.clearSelected()
			selected = {}
			for v, lbl in pairs(rowLabels) do
				lbl.Text = "•  " .. (rowBase[v] or "")
				lbl.TextColor3 = T.Text
			end
			valueLbl.Text = "none"
		end
		function api.isOpen() return isOpen end
		function api.close()
			isOpen = false; arrow.Text = "v"
			local tw = TweenService:Create(container, TweenInfo.new(0.22, Enum.EasingStyle.Quad), { Size = UDim2.new(1, 0, 0, 38) })
			tw:Play(); tw.Completed:Connect(function() if not isOpen then contentBox.Visible = false end end)
			task.delay(0.36, syncPanels)
		end
		function api.setEntries(newEntries)
			list:ClearAllChildren()
			make("UIListLayout", { Padding = UDim.new(0, 4) }, list)
			rowLabels, rowBase = {}, {}
			listH = math.min(#newEntries * 30 + 12, 180)
			for idx, e in ipairs(newEntries) do
				local row = make("TextButton", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(-0.3, 0, 0, 0),
					BackgroundColor3 = T.PanelD, Text = "", AutoButtonColor = false, ClipsDescendants = true }, list)
				corner(row, 7)
				local xOff = 10
				if e.image then
					local img = make("ImageLabel", { Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(0, 8, 0, 2),
						BackgroundTransparency = 1, Image = e.image }, row)
					corner(img, 6); xOff = 38
				end
				local mark = opts.multi and (selected[e.value] and "✓  " or "•  ") or ""
				local lbl = make("TextLabel", { Size = UDim2.new(1, -xOff - 10, 1, 0), Position = UDim2.new(0, xOff, 0, 0),
					BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = mark .. e.text,
					TextColor3 = (opts.multi and selected[e.value]) and T.Accent or (e.color or T.Text),
					TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd }, row)
				rowLabels[e.value] = lbl
				rowBase[e.value] = e.text
				hover(row, T.PanelD, T.Hover)
				TweenService:Create(row, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0, false, idx * 0.02),
					{ Position = UDim2.new(0, 0, 0, 0) }):Play()
				row.MouseButton1Down:Connect(function() ripple(row) end)
				row.MouseButton1Click:Connect(function()
					playClick()
					if opts.multi then
						selected[e.value] = (not selected[e.value]) or nil
						lbl.Text = (selected[e.value] and "✓  " or "•  ") .. e.text
						lbl.TextColor3 = selected[e.value] and T.Accent or (e.color or T.Text)
						updateCount()
						if onSelect then onSelect(e) end
					else
						api.setValue(e.value, e.text)
						if onSelect then onSelect(e) end
						if not opts.keepOpen then api.close() end
					end
				end)
			end
			if opts.multi then updateCount() end
			if isOpen then
				contentBox.Size = UDim2.new(1, 0, 0, listH + extraH + 16)
				list.Size = UDim2.new(1, -16, 0, listH)
				container.Size = UDim2.new(1, 0, 0, 42 + listH + extraH + 16)
				task.delay(0.05, syncPanels)
			end
		end
		header.MouseButton1Down:Connect(function() ripple(header) end)
		header.MouseButton1Click:Connect(function()
			playClick(); isOpen = not isOpen
			if isOpen then
				arrow.Text = "^"; contentBox.Visible = true
				TweenService:Create(container, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Size = UDim2.new(1, 0, 0, 42 + listH + extraH + 16) }):Play()
			else api.close() end
			if opts.onToggle then opts.onToggle(isOpen) end
			task.delay(0.36, syncPanels)
		end)
		api.setEntries(entries)
		if opts.buildExtra then
			local extraFrame = make("Frame", { Size = UDim2.new(1, -16, 0, extraH), Position = UDim2.new(0, 8, 0, listH + 12),
				BackgroundTransparency = 1 }, contentBox)
			make("UIListLayout", { Padding = UDim.new(0, 6) }, extraFrame)
			opts.buildExtra(extraFrame)
		end
		return api
	end

