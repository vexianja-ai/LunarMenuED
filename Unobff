local function mobileButtonRoot()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("HUD")
	return hud and hud:FindFirstChild("MobileButtons")
end

local function readThumbstick()
	local root = mobileButtonRoot()
	if not root then return Vector2.zero end
	local stick
	for _, d in ipairs(root:GetDescendants()) do
		local n = d.Name:lower()
		if d:IsA("GuiObject") and (n:find("thumb") or n:find("stick") or n:find("joystick")) then
			stick = d
			break
		end
	end
	if not stick then return Vector2.zero end
	local centre = stick.AbsolutePosition + stick.AbsoluteSize / 2
	local radius = math.min(stick.AbsoluteSize.X, stick.AbsoluteSize.Y) / 2
	if radius <= 1 then return Vector2.zero end
	local best, bestDist = nil, 0
	for _, d in ipairs(stick:GetDescendants()) do
		if d:IsA("GuiObject") then
			local c = d.AbsolutePosition + d.AbsoluteSize / 2
			local dist = (c - centre).Magnitude
			if dist > bestDist then best, bestDist = d, dist end
		end
	end
	if not best then return Vector2.zero end
	local delta = (best.AbsolutePosition + best.AbsoluteSize / 2 - centre) / radius
	if delta.Magnitude < 0.12 then return Vector2.zero end
	return Vector2.new(delta.X, -delta.Y)
end

local function mobileButtonKey(obj, root)
	local parts = {}
	local node = obj
	while node and node ~= root do
		table.insert(parts, 1, node.Name)
		node = node.Parent
	end
	return table.concat(parts, "/")
end

local function collectMobileButtons()
	local root = mobileButtonRoot()
	if not root then return {}, nil end
	local list = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiButton") then table.insert(list, d) end
	end
	return list, root
end

local function loadMobilePositions()
	local root = mobileButtonRoot()
	if not root then return 0 end
	local raw
	for _, path in ipairs({ MOBILE_FILE, MOBILE_FALLBACK }) do
		if fileExists(path) then
			local ok, r = pcall(readfile, path)
			if ok and r and r ~= "" then raw = r; break end
		end
	end
	if not raw then return 0 end
	local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(data) ~= "table" then return 0 end
	local applied = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiButton") then
			local p4 = data[mobileButtonKey(d, root)]
			if type(p4) == "table" and #p4 >= 4 then
				local okk = pcall(function() d.Position = UDim2.new(p4[1], p4[2], p4[3], p4[4]) end)
				if okk then applied += 1 end
			end
		end
	end
	return applied
end

local function setMobileButtonsDraggable(on)
	mobileDragActive = on
	local list, root = collectMobileButtons()
	if not root then showNotification("HUD.MobileButtons not found", 1.8); return end
	if on then
		mobileButtonSnapshot = {}
		for _, b in ipairs(list) do
			mobileButtonSnapshot[b] = b.Position
			pcall(function() b.Draggable = true end)
		end
		local n = loadMobilePositions()
		showNotification("Draggable ON — " .. #list .. " button(s)" .. (n > 0 and (", " .. n .. " loaded") or ""), 2)
	else
		for _, b in ipairs(list) do pcall(function() b.Draggable = false end) end
		showNotification("Mobile buttons locked", 1.5)
	end
end

local function saveMobilePositions()
	local list, root = collectMobileButtons()
	if not root then showNotification("HUD.MobileButtons not found", 1.8); return end
	local out = {}
	for _, d in ipairs(list) do
		out[mobileButtonKey(d, root)] = { d.Position.X.Scale, d.Position.X.Offset, d.Position.Y.Scale, d.Position.Y.Offset }
	end
	local ok, encoded = pcall(function() return HttpService:JSONEncode(out) end)
	if not ok or not encoded then showNotification("Encode failed", 1.6); return end
	local target = ensureSaveFolder() and MOBILE_FILE or MOBILE_FALLBACK
