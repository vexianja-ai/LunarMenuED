	Good   = Color3.fromRGB(80, 240, 130),
	Bad    = Color3.fromRGB(255, 95, 115),
	Warn   = Color3.fromRGB(255, 205, 90),
}

local themeRegistry = {}
for k in pairs(T) do themeRegistry[k] = {} end
local THEME_PROPS = {"BackgroundColor3","TextColor3","Color","ImageColor3","PlaceholderColor3","ScrollBarImageColor3","TextStrokeColor3"}

local function trackTheme(inst)
	local keys = {}
	for k, v in pairs(T) do keys[#keys + 1] = {k, v} end
	for _, prop in ipairs(THEME_PROPS) do
		local ok, c = pcall(function() return inst[prop] end)
		if ok and typeof(c) == "Color3" then
			for _, kv in ipairs(keys) do
				if c == kv[2] then
					table.insert(themeRegistry[kv[1]], {inst = inst, prop = prop})
					break
				end
			end
		end
	end
end

local function applyThemeLive()
	for key, list in pairs(themeRegistry) do
		local col = T[key]
		for _, e in ipairs(list) do
			if e.inst then
				if e.kind == "gradient" then
					local a = typeof(e.a) == "string" and T[e.a] or e.a
					local b = typeof(e.b) == "string" and T[e.b] or e.b
					pcall(function() e.inst.Color = ColorSequence.new(a, b) end)
				else
					pcall(function() e.inst[e.prop] = col end)
				end
			end
		end
	end
end

local function themeGradient(parent, a, b, rotation)
	local colA = typeof(a) == "string" and T[a] or a
	local colB = typeof(b) == "string" and T[b] or b
	local g = Instance.new("UIGradient")
	g.Color = colB and ColorSequence.new(colA, colB) or ColorSequence.new(colA)
	if rotation then g.Rotation = rotation end
	g.Parent = parent
	table.insert(themeRegistry[a] or themeRegistry.Accent, {inst = g, kind = "gradient", a = a, b = b})
	return g
end

