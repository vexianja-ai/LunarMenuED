	local function createSlider(parent, label, minV, maxV, default, step, onChange, tip)
		local holder = make("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1 }, parent)
		local lbl = make("TextLabel", { Size = UDim2.new(1, -62, 0, 16), BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium, Text = label, TextColor3 = T.Dim, TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left }, holder)
		if tip then addTooltip(lbl, tip) end
		local valBox = make("TextBox", { Size = UDim2.new(0, 54, 0, 18), Position = UDim2.new(1, -54, 0, 0),
			Text = tostring(default) }, holder)
		styleField(valBox); valBox.TextSize = 10

		local track = make("TextButton", { Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 26),
			BackgroundColor3 = Color3.fromRGB(18, 22, 42), Text = "", AutoButtonColor = false,
			Active = true, ClipsDescendants = false }, holder)
		corner(track, 99); stroke(track, Color3.fromRGB(60, 80, 160), 0.5)
		local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, track)
		corner(fill, 99)
		themeGradient(fill, Color3.fromRGB(60, 110, 255), "Accent2")
		local knobGlow = make("Frame", { Size = UDim2.new(0, 22, 0, 22), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.7, BorderSizePixel = 0 }, fill)
		corner(knobGlow, 99)
		local knob = make("Frame", { Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(240, 250, 255), BorderSizePixel = 0 }, fill)
		corner(knob, 99); stroke(knob, T.Accent, 0, 2)

		local function fmt(v)
			if step and step < 1 then
				local dec = math.max(0, math.ceil(-math.log10(step)))
				return string.format("%." .. dec .. "f", v)
			end
			return tostring(math.floor(v + 0.5))
		end

		local value = default
		local sliding = false
		local lockedScroll = nil

		local function apply(v, instant)
			value = math.clamp(v, minV, maxV)
			if step and step > 0 then value = math.floor(value / step + 0.5) * step end
			value = math.clamp(value, minV, maxV)
			local frac = (maxV == minV) and 0 or (value - minV) / (maxV - minV)
			lbl.Text = label .. ": " .. fmt(value)
			valBox.Text = fmt(value)
			fill.Size = UDim2.new(frac, 0, 1, 0)
			if onChange then onChange(value) end
		end

		local function fromX(px)
			apply(minV + math.clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1) * (maxV - minV), true)
		end

		track.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				lockedScroll = findScrollParent(track)
				if lockedScroll then lockedScroll.ScrollingEnabled = false end
				playClick()
				TweenService:Create(knob, TweenInfo.new(0.1), { Size = UDim2.new(0, 19, 0, 19) }):Play()
				fromX(i.Position.X)
			end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				fromX(i.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				if sliding then
					sliding = false
					if lockedScroll then lockedScroll.ScrollingEnabled = true; lockedScroll = nil end
					TweenService:Create(knob, TweenInfo.new(0.1), { Size = UDim2.new(0, 16, 0, 16) }):Play()
				end
			end
		end)
		valBox.FocusLost:Connect(function() apply(tonumber(valBox.Text) or value, false); saveConfig() end)
		apply(default, true)
		return { set = function(v) apply(v, false) end, get = function() return value end, holder = holder }
	end

