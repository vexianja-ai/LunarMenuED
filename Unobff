local function hover(btn, base, over, str)
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(.2, Enum.EasingStyle.Quad), {BackgroundColor3 = over}):Play()
		if str then TweenService:Create(str, TweenInfo.new(.2), {Color = T.Accent, Transparency = 0.1}):Play() end
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(.22, Enum.EasingStyle.Quad), {BackgroundColor3 = base}):Play()
		if str then TweenService:Create(str, TweenInfo.new(.22), {Color = T.Stroke, Transparency = 0.45}):Play() end
	end)
