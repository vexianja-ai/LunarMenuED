		tBtn.MouseButton1Click:Connect(function() applyWellness("Thirst", thirstBox) end)

		sectionTitle(p, "Server")
		local srvRow = make("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1 }, p)
		local rejoinBtn = createButton(srvRow, "Rejoin Server", Color3.fromRGB(38, 110, 60), "Reconnect to this exact server")
		rejoinBtn.Size = UDim2.new(0.49, 0, 1, 0)
		rejoinBtn.MouseButton1Click:Connect(function()
			showNotification("Rejoining...", 1.5)
			pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
		end)
		local hopBtn = createButton(srvRow, "Server Hop", Color3.fromRGB(41, 128, 185), "Jump to a different server of this game")
		hopBtn.Size = UDim2.new(0.49, 0, 1, 0)
		hopBtn.Position = UDim2.new(0.51, 0, 0, 0)
		hopBtn.MouseButton1Click:Connect(function()
			showNotification("Searching servers...", 1.5)
			task.spawn(function()
				local data = httpJson(("https://games.roblox.com/v1/games/%d/servers/Public?limit=100"):format(game.PlaceId))
				if not data or type(data.data) ~= "table" then
					showNotification("Server list unavailable", 2); return
				end
				local pool = {}
				for _, srv in ipairs(data.data) do
					if srv.id ~= game.JobId and srv.playing < srv.maxPlayers and srv.playing < 40 then
						table.insert(pool, srv)
					end
				end
				if #pool == 0 then showNotification("No other servers found", 2); return end
				local pick = pool[math.random(1, #pool)]
