-- GLOBAL KEYBIND / PAGE NAV LISTENER
----------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end

	if listeningAction then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			local act = listeningAction; listeningAction = nil
			keybinds[act] = input.KeyCode
			local ref = keyRefs[act]
			if ref then
				ref.Text = "[" .. input.KeyCode.Name .. "]"
				ref.TextColor3 = T.Accent
			end
			saveConfig()
			showNotification("Bound [" .. input.KeyCode.Name .. "] -> " .. act, 1.6)
		end
		return
	end

	if UserInputService:GetFocusedTextBox() then return end

	-- arrow keys: page travel while UI is open and not minimized
	if uiRefs.gui and uiRefs.gui.Parent and not uiRefs.minimized and uiRefs.goToPage then
		local names = { "General", "Item", "Builder", "Miscellaneous", "Settings" }
		local idx = table.find(names, currentPageName) or 1
		if input.KeyCode == Enum.KeyCode.Up then
			uiRefs.goToPage(names[math.max(idx - 1, 1)])
			return
		elseif input.KeyCode == Enum.KeyCode.Down then
			uiRefs.goToPage(names[math.min(idx + 1, #names)])
			return
		end
	end

	for act, key in pairs(keybinds) do
		if key ~= Enum.KeyCode.Unknown and input.KeyCode == key and keyTriggers[act] then
			keyTriggers[act]()
		end
	end
end)

